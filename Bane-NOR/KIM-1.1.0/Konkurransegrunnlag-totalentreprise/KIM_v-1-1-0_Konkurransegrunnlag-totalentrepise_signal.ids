    <ids:specification name="15906 Radio block center" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCCOMMUNICATIONSAPPLIANCE</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>RADIOBLOCKCENTER</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
