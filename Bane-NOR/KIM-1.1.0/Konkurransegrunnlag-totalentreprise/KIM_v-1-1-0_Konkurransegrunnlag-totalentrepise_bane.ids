        </ids:property>
        <ids:property instructions="SleeperArrangement || from IFC documentation: Define the rail joint sleeper method of assembly (&quot;twin sleeper&quot; type or &quot;between sleepers&quot; type)." dataType="IFCLABEL">
          <ids:propertySet>
