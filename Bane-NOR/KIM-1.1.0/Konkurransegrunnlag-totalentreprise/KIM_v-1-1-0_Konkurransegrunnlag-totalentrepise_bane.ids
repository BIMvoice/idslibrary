        <ids:property instructions="RailGap || from IFC documentation: The gap between the rail profiles." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_MechanicalFastenerTypeRailJoint</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RailGap</ids:simpleValue>
