    <ids:specification name="21103 Sville" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCTRACKELEMENT</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>SLEEPER</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="HasSpecialEquipment || from IFC documentation: Indicates whether the sleeper has any special equipment for fastening components (e.g. Balise, signum magnet) or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementOccurrenceSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasSpecialEquipment</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsContaminatedSleeper || from IFC documentation: Indicates whether the sleeper is contaminated and requires special disposal or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementOccurrenceSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsContaminatedSleeper</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SequenceInTrackPanel || from IFC documentation: Sequence of the sleeper within the track panel." dataType="IFCINTEGER">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementOccurrenceSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SequenceInTrackPanel</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="UnderSleeperPadStiffness || from IFC documentation: Indicates the stiffness of the under-sleeper pad as design reference for the sleeper." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementOccurrenceSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>UnderSleeperPadStiffness</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="MEDIUM"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SOFT"/>
              <xs:enumeration value="STIFF"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="FasteningType || from IFC documentation: Indicates the type of fastening used to generate traction between the foot of the rail and the sleeper. It depends on but is not uniquely identified by the type of sleeper. This property shall only be used when sleeper fastening is not modelled as an element." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementTypeSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FasteningType</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="HollowSleeperUsage || from IFC documentation: Indicates the purpose of using hollow sleeper. The possible value can be eg. cable trenching, protection of turnout mechanism, etc." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementTypeSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HollowSleeperUsage</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InstalledCondition || from IFC documentation: Assessment of the condition of the element at point of installation." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementTypeSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InstalledCondition</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="NEW"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="REGENERATED"/>
              <xs:enumeration value="REUSED"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="IsElectricallyInsulated || from IFC documentation: Indicates whether the sleeper is electrically insulated due to its design or the running rails or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementTypeSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsElectricallyInsulated</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsHollowSleeper || from IFC documentation: Indicates whether the sleeper is hollowed or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementTypeSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsHollowSleeper</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NumberOfTrackCenters || from IFC documentation: Indicates the number of track centers running over the sleepers." dataType="IFCCOUNTMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementTypeSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NumberOfTrackCenters</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SleeperType || from IFC documentation: Indicates the sleeper type." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementTypeSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SleeperType</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COMPOSITESLEEPER"/>
              <xs:enumeration value="CONCRETESLEEPER"/>
              <xs:enumeration value="INSULATEDSTEELSLEEPER"/>
              <xs:enumeration value="MONOBLOCKCONCRETESLEEPER"/>
              <xs:enumeration value="NOTINSULATEDSTEELSLEEPER"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="TWOBLOCKCONCRETESLEEPER"/>
              <xs:enumeration value="UNSET"/>
              <xs:enumeration value="WOODENSLEEPER"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="TechnicalStandard || from IFC documentation: The technical standard which the element should comply with." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_TrackElementTypeSleeper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TechnicalStandard</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="21201 Sporstopper" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCIMPACTPROTECTIONDEVICE</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>BUMPER</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="PSET_100168 : Status || from IFC documentation: Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementComponentCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BrakingLength || from IFC documentation: Length of the braking distance as a design parameter of the bumper occurrence." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceOccurrenceBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BrakingLength</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BumperOrientation || from IFC documentation: Direction in which the bumper is aligned, e.g. same direction as increasing stationing values or opposite." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceOccurrenceBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BumperOrientation</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OPPOSITETOSTATIONDIRECTION"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="STATIONDIRECTION"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="IsRemovableBumper || from IFC documentation: Indicates if the bumper is removable or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceOccurrenceBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsRemovableBumper</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="EnergyAbsorption || from IFC documentation: Energy absorption capacity of the element." dataType="IFCENERGYMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceTypeBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>EnergyAbsorption</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsAbsorbingEnergy || from IFC documentation: Indicates whether the bumper absorbs energy or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceTypeBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsAbsorbingEnergy</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="MaximumLoadRetention || from IFC documentation: Maximum possible impact load retention." dataType="IFCFORCEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceTypeBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MaximumLoadRetention</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
