      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="LRMConstraint || from IFC documentation: Allows for the specification of constraints imposed by this Linear Referencing Method. For example, a Reference Post Linear Referencing Method may specify that referents be of type reference marker.NOTE definition according to ISO 19148:2021" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_LinearReferencingMethod</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LRMConstraint</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="LRMName || from IFC documentation: Gives the name of this Linear Referencing Method, such as kilometre-point.NOTE Definition according to ISO 19148:2021.&#10;NOTE Names of commonly used Linear Referencing Methods are included in ISO 19148, Annex C, along with recognized name aliases." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_LinearReferencingMethod</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LRMName</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="LRMType || from IFC documentation: Gives the type of this Linear Referencing Method.NOTE Definition according to ISO 19148:2021, LRMType.&#10;NOTE Since the definition in ISO 19148:2021, LRMType is stereotyped as a CodeList it is open for user defined extensions. In this Pset this is handled by adding the enumeration constant LRM_USERDEFINED and the additional property UserDefinedLRMType" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_LinearReferencingMethod</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LRMType</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="LRM_ABSOLUTE"/>
              <xs:enumeration value="LRM_INTERPOLATIVE"/>
              <xs:enumeration value="LRM_RELATIVE"/>
              <xs:enumeration value="LRM_USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="LRMUnit || from IFC documentation: Specifies the units of measure used by this Linear Referencing Method for measures along the linear element being measured.NOTE Definition according to ISO 19148:2021." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_LinearReferencingMethod</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LRMUnit</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="UserDefinedLRMType || from IFC documentation: Gives the user defined type of this Linear Referencing Method when property LRMType is LRM_USERDEFINED." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_LinearReferencingMethod</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>UserDefinedLRMType</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
