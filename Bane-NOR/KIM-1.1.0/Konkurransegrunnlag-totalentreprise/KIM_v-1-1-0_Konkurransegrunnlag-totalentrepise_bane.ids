<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!-- INFO: Export generated by BIMQ. Further information available at https://www.bimq.de -->
  <ids:info>
    <ids:title>TEMPLATE: KIM - Versjon 1.1.0</ids:title>
    <ids:version>1.1.0</ids:version>
    <ids:description>Versjon 1.1.0 av KIM. Publisert januar 2026. Ferdige kravsett er generelle krav, Bane, RIE, KL, Signal og Tele</ids:description>
    <ids:author>eivind.pagander.tysnes@banenor.no</ids:author>
    <ids:date>2026-01-13</ids:date>
    <ids:purpose>Konkurransegrunnlag - Totalentreprise (3-32)</ids:purpose>
    <ids:milestone>Byggeplan (3)</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="11709 Sporplate" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSLAB</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>TRACKSLAB</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NOSSB00104 : Funksjonell Lokasjon || Funksjonell lokasjon er et element i en funksjonsorientert systemnedbrytningsstruktur, og den representerer en funksjon som utføres på en geografisk plassering. Eksempel: sporveksel nr. 1 på Grindvoll stasjon." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FunksjonellLokasjon</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PSET_100101 : AcousticRating || from IFC documentation: Acoustic rating for this object.&#10;It is provided according to the national building code. It indicates the sound transmission resistance of this object by an index ratio (instead of providing full sound absorption values)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AcousticRating</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PSET_100168 : Status || from IFC documentation: Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AssemblyPlace || from IFC documentation: Enumeration defining where the assembly is intended to take place, either in a factory, other offsite location or on the building site." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AssemblyPlace</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="FACTORY"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OFFSITE"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SITE"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="CastingMethod || from IFC documentation: The method of casting the concrete into its designed form." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CastingMethod</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="INSITU"/>
              <xs:enumeration value="MIXED"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="PRECAST"/>
              <xs:enumeration value="PRINTED"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="ConcreteCover || from IFC documentation: The protective concrete cover at the reinforcing bars according to local building regulations." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ConcreteCover</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ConcreteCoverAtLinks || from IFC documentation: The protective concrete cover at the reinforcement links according to local building regulations." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ConcreteCoverAtLinks</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ConcreteCoverAtMainBars || from IFC documentation: The protective concrete cover at the main reinforcing bars according to local building regulations." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ConcreteCoverAtMainBars</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ConstructionToleranceClass || from IFC documentation: Classification designation of the on-site construction tolerances according to local standards." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ConstructionToleranceClass</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="DimensionalAccuracyClass || from IFC documentation: Classification designation of the dimensional accuracy requirement according to local standards." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>DimensionalAccuracyClass</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ExposureClass || from IFC documentation: Classification of exposure to environmental conditions, usually specified in accordance with the concrete design code which is applied in the project." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ExposureClass</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ReinforcementAreaRatio || from IFC documentation: The required ratio of the effective area of the reinforcement to the effective area of the concrete At any section of a reinforced concrete structural element." dataType="IFCAREADENSITYMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ReinforcementAreaRatio</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ReinforcementStrengthClass || from IFC documentation: Classification of the reinforcement strength in accordance with the concrete design code which is applied in the project. The reinforcing strength class often combines strength and ductility." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ReinforcementStrengthClass</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ReinforcementVolumeRatio || from IFC documentation: The required ratio of the effective mass of the reinforcement to the effective volume of the concrete of a reinforced concrete structural element." dataType="IFCMASSDENSITYMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ReinforcementVolumeRatio</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="StrengthClass || from IFC documentation: Classification of the concrete strength in accordance with the concrete design code which is applied in the project." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>StrengthClass</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="StructuralClass || from IFC documentation: The structural class defined for the concrete structure (e.g. '1')." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>StructuralClass</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="HasDrainage || from IFC documentation: Indicates whether the infrastructure element has drainage embedded or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_EmbeddedTrack</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasDrainage</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsAccessibleByVehicle || from IFC documentation: Indicates whether the element is accessible by a vehicle or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_EmbeddedTrack</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsAccessibleByVehicle</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PermissibleRoadLoad || from IFC documentation: Permissible traffic load for the road design." dataType="IFCMASSMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_EmbeddedTrack</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PermissibleRoadLoad</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AssemblyPlace || from IFC documentation: Enumeration defining where the assembly is intended to take place, either in a factory, other offsite location or on the building site." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AssemblyPlace</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="FACTORY"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OFFSITE"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SITE"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="AsBuiltLocationNumber || from IFC documentation: Defines a unique location within a structure, the slot into which the piece was installed. Where pieces share the same piece mark, they can be interchanged. The value is only known after erection." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AsBuiltLocationNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PieceMark || from IFC documentation: Defines a unique piece for production purposes. All pieces with the same piece mark value are identical and interchangeable. The piece mark may be composed of sub-parts that have specific locally defined meaning (e.g. B-1A may denote a beam, of generic type 1 and specific shape A)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PieceMark</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ProductionLotId || from IFC documentation: The manufacturer's production lot identifier." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProductionLotId</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SerialNumber || from IFC documentation: The manufacturer's serial number assigned to an occurrence of a product." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SerialNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TypeDesignation || from IFC documentation: Type designator for the element. The content depends on local standards. Eg. 'Bull nose', 'Half batter', 'Dropper', 'Chamfer' etc" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeDesignation</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PitchAngle || from IFC documentation: Angle of the slab to the horizontal when used as a component for the roof (specified as 0 degrees or not asserted for cases where the slab is not used as a roof component).The shape information is provided in addition to the shape representation and the geometric parameters used within. In cases of inconsistency between the geometric parameters and the shape properties, provided in the attached property, the geometric parameters take precedence.  For geometry editing applications, like CAD: this value should be write-only." dataType="IFCPLANEANGLEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PitchAngle</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TechnicalStandard || from IFC documentation: The technical standard which the element should comply with." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_SlabTypeTrackSlab</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TechnicalStandard</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Depth || from IFC documentation: The depth of the object." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Depth</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossArea || from IFC documentation: Gross Area of the object. Openings, recesses, projections and cut-outs are not taken into account." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossVolume || from IFC documentation: Total gross volume of the object. Openings, recesses, enclosed objects and projections are not taken into account." dataType="IFCVOLUMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossWeight || from IFC documentation: Total Gross Weight of the object without any add-on parts and not taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCMASSMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossWeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Length || from IFC documentation: The length of the object." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Length</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetArea || from IFC documentation: Total net area of the object. Openings, recesses and cut-outs are taken into account by subtraction, projections by addition." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetVolume || from IFC documentation: Total net volume of the object, taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCVOLUMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetWeight || from IFC documentation: Total net weight of the object without add-on parts, taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCMASSMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetWeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Perimeter || from IFC documentation: Perimeter of the object." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Perimeter</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Width || from IFC documentation: The width of the object. Only given, if the object has constant thickness (prismatic)." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_SlabBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Width</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="12700 Fastmerke" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
