          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10017 : Geometri for eksisterende situasjon || Beskriver hva grunnlagsmodellen er basert på . Eksempler kan være eldre planprosess, banedata/kabelkart, FKB/SOSI, ortofoto og scann med lav kvalitet og scann med høy kvalitet." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GeometryDerivedFrom</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10018 : Beskrivelse av geometri for eksisterende situasjon || Beskrivende tekst. For eksempel hvem som har utført innmålinger, dato mm." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GeometrySource</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00105 : Innmålt || Er objektet innmålt" dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsSurveyed</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00106 : Innmålingsdato || dato for utført innmåling" dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SurveyDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
