          </ids:baseName>
        </ids:property>
        <ids:property instructions="Shortening || from IFC documentation: The ratio of the distance by which a precast piece is shortened after release from its form (due to compression induced by prestressing) to its original (nominal) length." dataType="IFCRATIOMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
