          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>EnergyAbsorption</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsAbsorbingEnergy || from IFC documentation: Indicates whether the bumper absorbs energy or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceTypeBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsAbsorbingEnergy</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="MaximumLoadRetention || from IFC documentation: Maximum possible impact load retention." dataType="IFCFORCEMEASURE">
