          </ids:value>
        </ids:property>
        <ids:property instructions="FasteningType || from IFC documentation: Indicates the type of fastening used to generate traction between the foot of the rail and the sleeper. It depends on but is not uniquely identified by the type of sleeper. This property shall only be used when sleeper fastening is not modelled as an element." dataType="IFCLABEL">
