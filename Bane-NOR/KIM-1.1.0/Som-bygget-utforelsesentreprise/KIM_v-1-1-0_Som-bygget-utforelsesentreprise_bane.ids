          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActualErectionDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ActualProductionDate || from IFC documentation: Production date (stripped from form)." dataType="IFCLABEL">
