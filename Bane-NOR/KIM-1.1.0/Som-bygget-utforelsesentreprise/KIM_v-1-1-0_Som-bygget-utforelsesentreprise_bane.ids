        <ids:property instructions="NOSSB00102 : Prosjektnedbrytning/områdekode || Angir kode til styringsobjektet som objektet befinner seg i (PNS)" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00103 : Objekt-ID || Unik objekt-ID for objektet. Eksempel er Banedata-ID, NVDB kode eller tilsvarende." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Objekt-ID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00104 : Funksjonell Lokasjon || Funksjonell lokasjon er et element i en funksjonsorientert systemnedbrytningsstruktur, og den representerer en funksjon som utføres på en geografisk plassering. Eksempel: sporveksel nr. 1 på Grindvoll stasjon." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FunksjonellLokasjon</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PSET_100168 : Status || from IFC documentation: Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementComponentCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="CorrosionTreatment || from IFC documentation: Determines corrosion treatment for metal components. This property is provided if the requirement needs to be expressed (a) independently of a material specification and (b) as a mere requirements statement rather than a workshop design/ processing feature." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementComponentCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CorrosionTreatment</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="EPOXYCOATED"/>
              <xs:enumeration value="GALVANISED"/>
              <xs:enumeration value="NONE"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="PAINTED"/>
              <xs:enumeration value="STAINLESS"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="DeliveryType || from IFC documentation: Determines how the accessory will be delivered to the site." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementComponentCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>DeliveryType</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="ATTACHED_FOR_DELIVERY"/>
              <xs:enumeration value="CAST_IN_PLACE"/>
              <xs:enumeration value="LOOSE"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="PRECAST"/>
              <xs:enumeration value="WELDED_TO_STRUCTURE"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="BrakingLength || from IFC documentation: Length of the braking distance as a design parameter of the bumper occurrence." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceOccurrenceBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BrakingLength</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BumperOrientation || from IFC documentation: Direction in which the bumper is aligned, e.g. same direction as increasing stationing values or opposite." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ImpactProtectionDeviceOccurrenceBumper</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
