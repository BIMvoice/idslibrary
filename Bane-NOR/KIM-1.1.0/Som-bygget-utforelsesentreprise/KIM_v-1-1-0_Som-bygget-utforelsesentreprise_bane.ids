          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OPPOSITETOSTATIONDIRECTION"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="STATIONDIRECTION"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="IsRemovableBumper || from IFC documentation: Indicates if the bumper is removable or not." dataType="IFCBOOLEAN">
