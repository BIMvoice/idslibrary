    <ids:specification name="12700 Fastmerke" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDINGELEMENTPROXY</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>SurveyControlStation</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NOBN10101 : Horisontalt referanseramme || Fastmerket originale horisontale referanseramme" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOBN_SurveyControlStation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HorisontalDatum</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOBN10102 : Høydereferanse || Fastmerkets originale høydereferanse" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOBN_SurveyControlStation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>VerticalReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOBN10103 : Nord || Nordkoordinat - er kun til informasjon. Korrekte koordinater hentes fra fastmerkeregisteret til eier av fastmerke." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOBN_SurveyControlStation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Northing</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOBN10104 : Øst || Østkoordinat - er kun til informasjon. Korrekte koordinater hentes fra fastmerkeregisteret til eier av fastmerke." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOBN_SurveyControlStation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Easting</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOBN10105 : Høyde || Høydekoordinat - er kun til informasjon. Korrekte koordinater hentes fra fastmerkeregisteret til eier av fastmerke." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOBN_SurveyControlStation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Elevation</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOBN10106 : Punkttype || Fastmerkets punktype, eks: sikringspunkt" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOBN_SurveyControlStation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Punkttype</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Sikringspunkt"/>
              <xs:enumeration value="Brukspunkt"/>
              <xs:enumeration value="Nivellementspunkt"/>
              <xs:enumeration value="Midlertidigpunkt"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB00101 : Prosesskode || Prosesskode iht. Bane NORs eller Statens Vegvesens prosesskoder for arbeidsbeskrivelser og kostnader." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
