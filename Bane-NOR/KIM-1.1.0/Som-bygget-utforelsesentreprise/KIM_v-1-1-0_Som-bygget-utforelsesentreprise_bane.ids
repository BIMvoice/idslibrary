          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="ATTACHED_FOR_DELIVERY"/>
              <xs:enumeration value="CAST_IN_PLACE"/>
              <xs:enumeration value="LOOSE"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="PRECAST"/>
              <xs:enumeration value="WELDED_TO_STRUCTURE"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="AcceptanceDate || from IFC documentation: Date on which the element is accepted by the manager or administrator." dataType="IFCDATE">
