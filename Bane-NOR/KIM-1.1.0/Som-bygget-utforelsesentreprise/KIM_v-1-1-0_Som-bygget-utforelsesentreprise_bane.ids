          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="ISOLATED_JOINT"/>
              <xs:enumeration value="JOINTED"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="UNSET"/>
              <xs:enumeration value="WELDED_AND_INSERTABLE"/>
              <xs:enumeration value="WELDED_AND_NOT_INSERTABLE"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="TypeOfTurnout || from IFC documentation: Type of turnout." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeOfTurnout</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DERAILMENT_TURNOUT"/>
              <xs:enumeration value="DIAMOND_CROSSING"/>
              <xs:enumeration value="DOUBLE_SLIP_CROSSING"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SCISSOR_CROSSOVER"/>
              <xs:enumeration value="SINGLE_SLIP_CROSSING"/>
              <xs:enumeration value="SLIP_TURNOUT_AND_SCISSORS_CROSSING"/>
              <xs:enumeration value="SYMMETRIC_TURNOUT"/>
              <xs:enumeration value="THREE_WAYS_TURNOUT"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="AcceptanceDate || from IFC documentation: Date on which the element is accepted by the manager or administrator." dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AcceptanceDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InstallationDate || from IFC documentation: Date on which the element is installed." dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InstallationDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
