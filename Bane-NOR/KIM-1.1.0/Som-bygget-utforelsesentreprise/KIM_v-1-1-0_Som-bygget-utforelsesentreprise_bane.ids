          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActualProductionDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AsBuiltLocationNumber || from IFC documentation: Defines a unique location within a structure, the slot into which the piece was installed. Where pieces share the same piece mark, they can be interchanged. The value is only known after erection." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AsBuiltLocationNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PieceMark || from IFC documentation: Defines a unique piece for production purposes. All pieces with the same piece mark value are identical and interchangeable. The piece mark may be composed of sub-parts that have specific locally defined meaning (e.g. B-1A may denote a beam, of generic type 1 and specific shape A)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PieceMark</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ProductionLotId || from IFC documentation: The manufacturer's production lot identifier." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProductionLotId</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SerialNumber || from IFC documentation: The manufacturer's serial number assigned to an occurrence of a product." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SerialNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TypeDesignation || from IFC documentation: Type designator for the element. The content depends on local standards. Eg. 'Bull nose', 'Half batter', 'Dropper', 'Chamfer' etc" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeDesignation</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BatterAtEnd || from IFC documentation: The angle, in radians, by which the formwork at the ending face of a piece is to be rotated from the vertical in order to compensate for the rotation of the face that will occur once the piece is stripped from its form, inducing camber due to eccentric prestressing." dataType="IFCPLANEANGLEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BatterAtEnd</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BatterAtStart || from IFC documentation: The angle, in radians, by which the formwork at the starting face of a piece is to be rotated from the vertical in order to compensate for the rotation of the face that will occur once the piece is stripped from its form, inducing camber due to eccentric prestressing." dataType="IFCPLANEANGLEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BatterAtStart</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="CamberAtMidspan || from IFC documentation: The camber deflection, measured from the midpoint of a cambered face of a piece to the midpoint of the chord joining the ends of the same face, as shown in the figure below, divided by the original (nominal) straight length of the face of the piece." dataType="IFCRATIOMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CamberAtMidspan</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="CornerChamfer || from IFC documentation: The chamfer in the corners of the precast element. The chamfer is presumed to be equal in both directions." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CornerChamfer</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="DesignLocationNumber || from IFC documentation: Defines a unique location within a structure, the slot for which the piece was designed." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>DesignLocationNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="FormStrippingStrength || from IFC documentation: The minimum required compressive strength of the concrete at form stripping time." dataType="IFCPRESSUREMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
