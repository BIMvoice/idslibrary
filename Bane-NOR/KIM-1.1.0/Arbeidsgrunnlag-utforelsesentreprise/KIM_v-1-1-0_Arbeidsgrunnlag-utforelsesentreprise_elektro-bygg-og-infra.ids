              <xs:enumeration value="WALL"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="TemperatureClassification || from IFC documentation: Enumeration defining the temperature classification of the space heater surface temperature.&#10;low temperature - surface temperature is relatively low, usually heated by hot water or electricity.&#10;high temperature - surface temperature is relatively high, usually heated by gas or steam." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceHeaterTypeCommon</ids:simpleValue>
