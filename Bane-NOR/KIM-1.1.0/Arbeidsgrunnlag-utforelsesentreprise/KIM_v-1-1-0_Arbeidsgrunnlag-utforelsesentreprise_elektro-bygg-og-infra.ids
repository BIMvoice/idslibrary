        </ids:property>
        <ids:property instructions="NOSSB00101 : Prosesskode || Prosesskode iht. Bane NORs eller Statens Vegvesens prosesskoder for arbeidsbeskrivelser og kostnader." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
