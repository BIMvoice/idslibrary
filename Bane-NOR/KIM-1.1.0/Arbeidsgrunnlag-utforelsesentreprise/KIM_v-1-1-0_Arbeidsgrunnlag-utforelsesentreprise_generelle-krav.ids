  <ids:info>
    <ids:title>TEMPLATE: KIM - Versjon 1.1.0</ids:title>
    <ids:version>1.1.0</ids:version>
    <ids:description>Versjon 1.1.0 av KIM. Publisert januar 2026. Ferdige kravsett er generelle krav, Bane, RIE, KL, Signal og Tele</ids:description>
    <ids:author>eivind.pagander.tysnes@banenor.no</ids:author>
    <ids:date>2026-01-22</ids:date>
    <ids:purpose>Arbeidsgrunnlag - Utførelsesentreprise (4-41)</ids:purpose>
    <ids:milestone>Byggefase (4)</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="01000 Prosjekt" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="ATT01001 : Prosjektnummer || Bane NORs prosjektnummer">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="ATT01002 : Prosjektnavn || Bane NORs prosjektnavn. Forkortelse skal ikke benyttes">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="ATT10008 : GUID || Global unik ID. Settes normalt automatisk av systemet.">
          <ids:name>
            <ids:simpleValue>GlobalId</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS11802 : Revisjonsnummer || Gjeldene revisjon av elementet" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RevisionNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS11803 : Beskrivelse av revisjon || Beskrivelse av endring på elementet i siste revisjon." dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RevisionDescription</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS11804 : Revisjonsdato || Dato på gjeldende revisjon" dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RevisionDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
