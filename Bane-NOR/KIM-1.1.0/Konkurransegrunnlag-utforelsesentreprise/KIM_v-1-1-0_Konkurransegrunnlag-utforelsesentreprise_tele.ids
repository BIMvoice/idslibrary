        </ids:property>
        <ids:property instructions="PSET_100168 : Status || from IFC documentation: Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AccessCoverLoadRating || from IFC documentation: The load rating of the access cover (which may be a value or an alphanumerically defined class rating)." dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AccessCoverLoadRating</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AccessCoverMaterial || from IFC documentation: The material from which the access cover to the chamber is constructed.&#10;NOTE: It is assumed that chamber walls will be constructed of a single material." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AccessCoverMaterial</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AccessLengthOrRadius || from IFC documentation: The length of the chamber access cover or, where the plan shape of the cover is circular, the radius." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AccessLengthOrRadius</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AccessWidth || from IFC documentation: The width of the chamber access cover where the plan shape of the cover is not circular." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AccessWidth</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BaseMaterial || from IFC documentation: The material from which the base of the chamber is constructed.&#10;NOTE: It is assumed that chamber base will be constructed of a single material." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BaseMaterial</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BaseThickness || from IFC documentation: The thickness of the base construction, assumed to be constructed at a single thickness." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BaseThickness</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="HasSteps || from IFC documentation: Indicates whether the chamber has steps (TRUE) or not (FALSE)." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasSteps</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InvertLevel || from IFC documentation: Level of the lowest part of the cross section as measured from ground level." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InvertLevel</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsAccessibleOnFoot || from IFC documentation: Indicates whether the element is accessible on foot (TRUE) or not (FALSE)." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsAccessibleOnFoot</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsLocked || from IFC documentation: Indicates whether the element is locked (TRUE) or not (FALSE)." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsLocked</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsShallow || from IFC documentation: Indicates whether the chamber has been designed as being shallow (TRUE) or deep (FALSE)." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsShallow</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NumberOfCableEntries || from IFC documentation: Indicates the number of cable entries in the manhole." dataType="IFCCOUNTMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NumberOfCableEntries</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NumberOfManholeCovers || from IFC documentation: Indicates the number of manhole covers." dataType="IFCCOUNTMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NumberOfManholeCovers</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SoffitLevel || from IFC documentation: Level of the highest internal part of the cross section as measured from ground level." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SoffitLevel</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TypeOfShaft || from IFC documentation: Additional information on the purpose of the shaft." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeOfShaft</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="WallMaterial || from IFC documentation: The material from which the wall of the chamber is constructed.&#10;NOTE: It is assumed that chamber walls will be constructed of a single material." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>WallMaterial</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="WallThickness || from IFC documentation: The thickness of the wall construction.&#10;NOTE: It is assumed that walls will be constructed at a single thickness." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>WallThickness</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="WithBackdrop || from IFC documentation: Indicates whether the chamber has a backdrop or tumbling bay (TRUE) or not (FALSE)." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionChamberElementTypeManhole</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>WithBackdrop</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Depth || from IFC documentation: The depth of the object." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_DistributionChamberElementBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Depth</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossSurfaceArea || from IFC documentation: Total gross area of the object, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_DistributionChamberElementBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossSurfaceArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossVolume || from IFC documentation: Total gross volume of the object. Openings, recesses, enclosed objects and projections are not taken into account." dataType="IFCVOLUMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_DistributionChamberElementBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetSurfaceArea || from IFC documentation: Net surface area of the object, normally generated as perimeter * length + 2 * cross section area taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_DistributionChamberElementBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetSurfaceArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetVolume || from IFC documentation: Total net volume of the object, taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCVOLUMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_DistributionChamberElementBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
