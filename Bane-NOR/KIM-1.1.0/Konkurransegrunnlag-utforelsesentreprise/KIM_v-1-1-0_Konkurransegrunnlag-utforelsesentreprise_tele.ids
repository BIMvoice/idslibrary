          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InstallationMethod || from IFC documentation: Method of installation of cable/conductor. Installation methods are typically defined by reference in standards such as IEC 60364-5-52, table 52A-1 or BS7671 Appendix 4 Table 4A1 etc. Selection of the value to be used should be determined from such a standard according to local usage." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_CableSegmentOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InstallationMethod</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="MaximumCableLength || from IFC documentation: Maximum cable length based on voltagedrop. NOTE: This value may also be specified as a constraint within an IFC model if required but is included within the property set at this stage pending implementation of the required capabilities within software applications." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_CableSegmentOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MaximumCableLength</ids:simpleValue>
          </ids:baseName>
        </ids:property>
