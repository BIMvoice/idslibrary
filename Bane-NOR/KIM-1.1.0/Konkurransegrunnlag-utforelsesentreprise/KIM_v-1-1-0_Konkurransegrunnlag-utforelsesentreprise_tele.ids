        <ids:property instructions="CorrosionTreatment || from IFC documentation: Determines corrosion treatment for metal components. This property is provided if the requirement needs to be expressed (a) independently of a material specification and (b) as a mere requirements statement rather than a workshop design/ processing feature." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementComponentCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CorrosionTreatment</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="EPOXYCOATED"/>
              <xs:enumeration value="GALVANISED"/>
              <xs:enumeration value="NONE"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="PAINTED"/>
              <xs:enumeration value="STAINLESS"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
