    <ids:specification name="10406 Drivmaskin" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCACTUATOR</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>ELECTRICACTUATOR</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NONS10402 : Datakommunikasjonstype || Kommuniserer typen datatilkobling (kobber, fiber, trådløs)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_DataConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>DataCommunicationType</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10502 : Elektrisk strøm || Kommuniserer krav til effekt for strømtilkobling. Oppgis i kW." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_ElectricalConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ElectricalPower</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10503 : Elektrisk forsyningssystem || Kommuniserer typen elektrisitetstilførsel, for eksempel normalkraft, reserve, avbruddsfri." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_ElectricalConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ElectricalSupplySystem</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00101 : Prosesskode || Prosesskode iht. Bane NORs eller Statens Vegvesens prosesskoder for arbeidsbeskrivelser og kostnader." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefClass</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00102 : Prosjektnedbrytning/områdekode || Angir kode til styringsobjektet som objektet befinner seg i (PNS)" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00103 : Objekt-ID || Unik objekt-ID for objektet. Eksempel er Banedata-ID, NVDB kode eller tilsvarende." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Objekt-ID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ActuatorApplication || from IFC documentation: Indicates application of actuator." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ActuatorTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActuatorApplication</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DAMPERACTUATOR"/>
              <xs:enumeration value="ENTRYEXITDEVICE"/>
              <xs:enumeration value="FIRESMOKEDAMPERACTUATOR"/>
              <xs:enumeration value="LAMPACTUATOR"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SUNBLINDACTUATOR"/>
              <xs:enumeration value="UNSET"/>
              <xs:enumeration value="VALVEPOSITIONER"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="ActuatorStatus || from IFC documentation: Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ActuatorTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActuatorStatus</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DEMOLISH"/>
              <xs:enumeration value="EXISTING"/>
              <xs:enumeration value="NEW"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="TEMPORARY"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="ActionBarMovementLength || from IFC documentation: The movement of the bar that pulls the point of a turnout." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PointMachine</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActionBarMovementLength</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ConversionTime || from IFC documentation: Turnout conversion completion time." dataType="IFCTIMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PointMachine</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ConversionTime</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Current || from IFC documentation: The actual current and operable range." dataType="IFCELECTRICCURRENTMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PointMachine</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Current</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="HasLockInside || from IFC documentation: Indicates whether the locking is inside  (TRUE) or outside (FALSE) of the point machine." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_PointMachine</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasLockInside</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="LockingForce || from IFC documentation: Locking force of the point machine motor." dataType="IFCFORCEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PointMachine</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LockingForce</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="MarkingRodMovementLength || from IFC documentation: The length of the movement bar which indicates the turnout position." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PointMachine</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MarkingRodMovementLength</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="MinimumOperatingSpeed || from IFC documentation: Minimum operating speed of the point machine." dataType="IFCANGULARVELOCITYMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PointMachine</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MinimumOperatingSpeed</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TractionForce || from IFC documentation: Traction force of the point machine in turnout conversion." dataType="IFCFORCEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PointMachine</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
