<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <!-- INFO: Export generated by BIMQ. Further information available at https://www.bimq.de -->
  <ids:info>
    <ids:title>TEMPLATE: KIM - Versjon 1.1.0</ids:title>
    <ids:version>1.1.0</ids:version>
    <ids:description>Versjon 1.1.0 av KIM. Publisert januar 2026. Ferdige kravsett er generelle krav, Bane, RIE, KL, Signal og Tele</ids:description>
    <ids:author>eivind.pagander.tysnes@banenor.no</ids:author>
    <ids:date>2026-01-13</ids:date>
    <ids:purpose>Arbeidsgrunnlag - Totalentreprise (4-42)</ids:purpose>
    <ids:milestone>Byggefase (4)</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="01800 Områdesone" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NONS10004 : Kontraktsnummer produksjon || Kontrakt-/entreprisenummer på utførsel/bygging. Kommuniserer hvem som er ansvarlig for utførelsen. Hvis det benyttes underentrepriser på flere nivåer i utførelsen, skal prosjektet avgjøre om nummeret skal angis laveste eller høyeste nivå eller på alle nivåene." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ConstructionContract</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10005 : Kontrollsone || Beskriver det enkelte objekts tilhørighet til kontrollsoner. Kontrollsoner er ikke et soneobjekt, men det området i modellen som man velger å kontrollere. Hvis et objekt tilhører flere kontrollsoner (for eksempel ett dekke som skal inngå i kontroll av objekter i kontrollsonene både over og under dekket), angis alle disse i samme streng atskilt med semikolon («;»)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ControlVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10009 : Utendørs || For å kunne skille ut tekniske installasjoner som ligger utenfor bygget, brukes en egendefinert egenskap med en av de tillatte verdiene, som er True eller False. Dette gjelder for komponenter og deler av systemer som ligger utenfor bygget, og som inngår i systemet der systemkomponenten og/eller størsteparten av systemet ligger inne i bygget." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsOutside</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10010 : Anskaffet || Kommuniserer at produktet som objektet representerer er innkjøpt. Selv om objektet ikke er ferdig prosjektert skal geometri og egenskaper være representative for det innkjøpte produktet. Denne kan brukes som alternativ til kode under ConstructedStatus som angir om produktet som objektet representerer er innkjøpt." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsProcured</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10013 : MMI || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS11802 : Revisjonsnummer || Gjeldene revisjon av elementet" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RevisionNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS11803 : Beskrivelse av revisjon || Beskrivelse av endring på elementet i siste revisjon." dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RevisionDescription</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS11804 : Revisjonsdato || Dato på gjeldende revisjon" dataType="IFCTIMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RevisionDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS11805 : Prosjektert av || Angir hvem som har prosjektert objektet. Benyttes for å ivareta krav i andre standarder for utførelse, kontroll og godkjenning, som vi blant annet kjenner fra dokumenter og tegninger" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>DesignedBy</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS11806 : Kontrollert av || Angir hvem som har kontrollert objektet. Benyttes for å ivareta krav i andre standarder for utførelse, kontroll og godkjenning, som vi blant annet kjenner fra dokumenter og tegninger" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ControlledBy</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS11807 : Godkjent av || Angir hvem som har godkjent objektet. Benyttes for å ivareta krav i andre standarder for utførelse, kontroll og godkjenning, som vi blant annet kjenner fra dokumenter og tegninger" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_Revision</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ApprovedBy</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="10500 Alarmorgan" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCALARM</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NONS10402 : Datakommunikasjonstype || Kommuniserer typen datatilkobling (kobber, fiber, trådløs)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_DataConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>DataCommunicationType</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10502 : Elektrisk strøm || Kommuniserer krav til effekt for strømtilkobling. Oppgis i kW." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_ElectricalConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ElectricalPower</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10503 : Elektrisk forsyningssystem || Kommuniserer typen elektrisitetstilførsel, for eksempel normalkraft, reserve, avbruddsfri." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_ElectricalConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ElectricalSupplySystem</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00102 : Prosjektnedbrytning/områdekode || Angir kode til styringsobjektet som objektet befinner seg i (PNS)" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00103 : Objekt-ID || Unik objekt-ID for objektet. Eksempel er Banedata-ID, NVDB kode eller tilsvarende." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Objekt-ID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00104 : Funksjonell Lokasjon || Funksjonell lokasjon er et element i en funksjonsorientert systemnedbrytningsstruktur, og den representerer en funksjon som utføres på en geografisk plassering. Eksempel: sporveksel nr. 1 på Grindvoll stasjon." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FunksjonellLokasjon</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PSET_100168 : Status || from IFC documentation: Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_AlarmTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AlarmCondition || from IFC documentation: Table mapping alarm condition identifiers to descriptive labels, which may be used for interpreting Pset_AlarmPHistory.Condition." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_AlarmTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AlarmCondition</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ConductorFunction || from IFC documentation: Indicates function of the conductors to which the load is connected. Where L1, L2 and L3 represent the phase lines according to IEC 60446 notation (sometimes phase lines may be referenced by color [Red, Blue, Yellow] or by number [1, 2, 3] etc). Protective Earth is sometimes also known as CPC or common protective conductor. Note that for an electrical device, a set of line conductor functions may be applied." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ConductorFunction</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="NEUTRAL"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="PHASE_L1"/>
              <xs:enumeration value="PHASE_L2"/>
              <xs:enumeration value="PHASE_L3"/>
              <xs:enumeration value="PROTECTIVEEARTH"/>
              <xs:enumeration value="PROTECTIVEEARTHNEUTRAL"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="EarthingStyle || from IFC documentation: Indicates the earthing style of the electric device." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>EarthingStyle</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="HasProtectiveEarth || from IFC documentation: Indicates whether the object has a protective earth connection (=TRUE) or not (= FALSE)." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasProtectiveEarth</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="HeatDissipation || from IFC documentation: Indicates the heat dissipation of the electric device measured in power." dataType="IFCPOWERMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HeatDissipation</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IK_Code || from IFC documentation: IK Code according to IEC 62262 (2002) is a numeric classification for the degree of protection provided by enclosures for electrical equipment against external mechanical impacts.NOTE  In earlier labeling, the third numeral (1..) had been occasionally added to the closely related IP Code on ingress protection, to indicate the level of impact protection." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IK_Code</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InsulationStandardClass || from IFC documentation: Insulation standard classes provides basic protection information against electric shock. Defines levels of insulation required in terms of constructional requirements (creepage and clearance distances) and electrical requirements (compliance with electric strength tests). Basic insulation is considered to be shorted under single fault conditions. The actual values required depend on the working voltage to which the insulation is subjected, as well as other factors. Also indicates whether the electrical device has a protective earth connection." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InsulationStandardClass</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="CLASS0APPLIANCE"/>
              <xs:enumeration value="CLASS0IAPPLIANCE"/>
              <xs:enumeration value="CLASSIAPPLIANCE"/>
              <xs:enumeration value="CLASSIIAPPLIANCE"/>
              <xs:enumeration value="CLASSIIIAPPLIANCE"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NominalFrequencyRange || from IFC documentation: The upper and lower limits of frequency for which the operation of the device is certified." dataType="IFCFREQUENCYMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NominalFrequencyRange</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NumberOfPoles || from IFC documentation: Number of poles that the object would affect." dataType="IFCCOUNTMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NumberOfPoles</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NumberOfPowerSupplyPorts || from IFC documentation: Indicates the number of power supply ports of the electric device." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NumberOfPowerSupplyPorts</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Power || from IFC documentation: The actual power and operable range." dataType="IFCPOWERMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Power</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PowerFactor || from IFC documentation: Power factor; usually as ratio." dataType="IFCNORMALISEDRATIOMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PowerFactor</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="RatedCurrent || from IFC documentation: The current that a device is designed to handle." dataType="IFCELECTRICCURRENTMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RatedCurrent</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="RatedVoltage || from IFC documentation: The range of allowed voltage that a device is certified to handle. The upper bound of this value is the maximum." dataType="IFCELECTRICVOLTAGEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElectricalDeviceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RatedVoltage</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AcceptanceDate || from IFC documentation: Date on which the element is accepted by the manager or administrator." dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AcceptanceDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InstallationDate || from IFC documentation: Date on which the element is installed." dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InstallationDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PutIntoOperationDate || from IFC documentation: Date on which the element is put into operation." dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>Pset_InstallationOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PutIntoOperationDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AcquisitionDate || from IFC documentation: The date that the manufactured item was purchased." dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AcquisitionDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AssemblyPlace || from IFC documentation: Enumeration defining where the assembly is intended to take place, either in a factory, other offsite location or on the building site." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AssemblyPlace</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="FACTORY"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OFFSITE"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SITE"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="BarCode || from IFC documentation: The identity of the bar code given to an occurrence of the product." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BarCode</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ManufacturingDate || from IFC documentation: Date on which the element was manufactured." dataType="IFCDATE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ManufacturingDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SerialNumber || from IFC documentation: The manufacturer's serial number assigned to an occurrence of a product." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SerialNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossWeight || from IFC documentation: Total Gross Weight of the object without any add-on parts and not taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCMASSMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_AlarmBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossWeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="11101 Høyttaler" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCAUDIOVISUALAPPLIANCE</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>SPEAKER</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NONS10402 : Datakommunikasjonstype || Kommuniserer typen datatilkobling (kobber, fiber, trådløs)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_DataConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>DataCommunicationType</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10502 : Elektrisk strøm || Kommuniserer krav til effekt for strømtilkobling. Oppgis i kW." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_ElectricalConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ElectricalPower</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00102 : Prosjektnedbrytning/områdekode || Angir kode til styringsobjektet som objektet befinner seg i (PNS)" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00103 : Objekt-ID || Unik objekt-ID for objektet. Eksempel er Banedata-ID, NVDB kode eller tilsvarende." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Objekt-ID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00104 : Funksjonell Lokasjon || Funksjonell lokasjon er et element i en funksjonsorientert systemnedbrytningsstruktur, og den representerer en funksjon som utføres på en geografisk plassering. Eksempel: sporveksel nr. 1 på Grindvoll stasjon." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FunksjonellLokasjon</ids:simpleValue>
          </ids:baseName>
        </ids:property>
