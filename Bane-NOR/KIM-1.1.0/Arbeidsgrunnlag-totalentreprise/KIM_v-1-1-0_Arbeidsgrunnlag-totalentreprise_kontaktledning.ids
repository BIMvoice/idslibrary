          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProductionYear</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SafetyDocument || from IFC documentation: Manufacturer's safety document" dataType="IFCLABEL">
          <ids:propertySet>
