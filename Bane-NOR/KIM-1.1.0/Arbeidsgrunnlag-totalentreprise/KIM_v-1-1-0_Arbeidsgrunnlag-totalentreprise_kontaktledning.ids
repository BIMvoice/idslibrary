        <ids:property instructions="ContactWireNominalHeight || from IFC documentation: Nominal distance from the top of the rail to the lower face of the contact wire, measured perpendicular to the track." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionSystemTypeOverheadContactlineSystem</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ContactWireNominalHeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ContactWireStagger || from IFC documentation: Lateral displacement of the contact wire to opposite sides of the track centre at successive supports." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
