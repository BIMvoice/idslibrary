          </ids:baseName>
        </ids:property>
        <ids:property instructions="ModelReference || from IFC documentation: The model number or designator of the product model (or product line) as assigned by the manufacturer of the manufactured item." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerTypeInformation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
