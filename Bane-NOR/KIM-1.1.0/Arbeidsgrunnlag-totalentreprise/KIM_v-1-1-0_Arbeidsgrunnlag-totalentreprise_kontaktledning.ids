          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SafetyDocument</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ActualErectionDate || from IFC documentation: Date erected." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActualErectionDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ActualProductionDate || from IFC documentation: Production date (stripped from form)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActualProductionDate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="AsBuiltLocationNumber || from IFC documentation: Defines a unique location within a structure, the slot into which the piece was installed. Where pieces share the same piece mark, they can be interchanged. The value is only known after erection." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AsBuiltLocationNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PieceMark || from IFC documentation: Defines a unique piece for production purposes. All pieces with the same piece mark value are identical and interchangeable. The piece mark may be composed of sub-parts that have specific locally defined meaning (e.g. B-1A may denote a beam, of generic type 1 and specific shape A)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PieceMark</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ProductionLotId || from IFC documentation: The manufacturer's production lot identifier." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProductionLotId</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SerialNumber || from IFC documentation: The manufacturer's serial number assigned to an occurrence of a product." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SerialNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TypeDesignation || from IFC documentation: Type designator for the element. The content depends on local standards. Eg. 'Bull nose', 'Half batter', 'Dropper', 'Chamfer' etc" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementFabrication</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeDesignation</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="DesignLocationNumber || from IFC documentation: Defines a unique location within a structure, the slot for which the piece was designed." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>DesignLocationNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InitialTension || from IFC documentation: The initial stress of the tendon. This property applies to prestressed concrete elements only." dataType="IFCPRESSUREMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InitialTension</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="LiftingStrength || from IFC documentation: The minimum required compressive strength of the concrete when the concrete element is lifted." dataType="IFCPRESSUREMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LiftingStrength</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ManufacturingToleranceClass || from IFC documentation: Classification designation of the manufacturing tolerances according to local standards." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ManufacturingToleranceClass</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SupportDuringTransportDescription || from IFC documentation: Textual description of how the concrete element is supported during transportation." dataType="IFCTEXT">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SupportDuringTransportDescription</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SupportDuringTransportDocReference || from IFC documentation: Reference to an external document defining how the concrete element is supported during transportation." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_PrecastConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SupportDuringTransportDocReference</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="CrossSectionArea || from IFC documentation: Total area of the cross section (or profile) of the object." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CrossSectionArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossSurfaceArea || from IFC documentation: Total gross area of the object, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossSurfaceArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossVolume || from IFC documentation: Total gross volume of the object. Openings, recesses, enclosed objects and projections are not taken into account." dataType="IFCVOLUMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossWeight || from IFC documentation: Total Gross Weight of the object without any add-on parts and not taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCMASSMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossWeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Height || from IFC documentation: Characteristic height." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Height</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Length || from IFC documentation: The length of the object." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Length</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetVolume || from IFC documentation: Total net volume of the object, taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCVOLUMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetWeight || from IFC documentation: Total net weight of the object without add-on parts, taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCMASSMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetWeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="OuterSurfaceArea || from IFC documentation: Total area of the extruded surfaces of the object (not taking into account the end cap areas), normally generated as perimeter * length." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>OuterSurfaceArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Width || from IFC documentation: The width of the object. Only given, if the object has constant thickness (prismatic)." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Width</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="14403 Isolator" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCDISCRETEACCESSORY</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NOSSB00102 : Prosjektnedbrytning/områdekode || Angir kode til styringsobjektet som objektet befinner seg i (PNS)" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00103 : Objekt-ID || Unik objekt-ID for objektet. Eksempel er Banedata-ID, NVDB kode eller tilsvarende." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Objekt-ID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00104 : Funksjonell Lokasjon || Funksjonell lokasjon er et element i en funksjonsorientert systemnedbrytningsstruktur, og den representerer en funksjon som utføres på en geografisk plassering. Eksempel: sporveksel nr. 1 på Grindvoll stasjon." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FunksjonellLokasjon</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InstallationMethod || from IFC documentation: Method of installation of cable/conductor. Installation methods are typically defined by reference in standards such as IEC 60364-5-52, table 52A-1 or BS7671 Appendix 4 Table 4A1 etc. Selection of the value to be used should be determined from such a standard according to local usage." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_DiscreteAccessoryTypeInsulator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InstallationMethod</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="InsulationMethod || from IFC documentation: The method used to insulate." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_DiscreteAccessoryTypeInsulator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InsulationMethod</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="LONGRODINSULATOR"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="PININSULATOR"/>
              <xs:enumeration value="POSTINSULATOR"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="InsulationVoltage || from IFC documentation: The insulation voltage." dataType="IFCELECTRICVOLTAGEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DiscreteAccessoryTypeInsulator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>InsulationVoltage</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="LightningPeakVoltage || from IFC documentation: The peak lightning voltage that the insulator could withstand." dataType="IFCELECTRICVOLTAGEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DiscreteAccessoryTypeInsulator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LightningPeakVoltage</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="RatedCurrent || from IFC documentation: The current that a device is designed to handle." dataType="IFCELECTRICCURRENTMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DiscreteAccessoryTypeInsulator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RatedCurrent</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="RatedVoltage || from IFC documentation: The range of allowed voltage that a device is certified to handle. The upper bound of this value is the maximum." dataType="IFCELECTRICVOLTAGEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DiscreteAccessoryTypeInsulator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RatedVoltage</ids:simpleValue>
