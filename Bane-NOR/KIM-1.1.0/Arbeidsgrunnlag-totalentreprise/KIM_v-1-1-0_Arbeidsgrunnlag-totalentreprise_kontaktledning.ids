    <ids:specification name="10407 Manøvermaskin" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCACTUATOR</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>ELECTRICACTUATOR</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NONS10502 : Elektrisk strøm || Kommuniserer krav til effekt for strømtilkobling. Oppgis i kW." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_ElectricalConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ElectricalPower</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NONS10503 : Elektrisk forsyningssystem || Kommuniserer typen elektrisitetstilførsel, for eksempel normalkraft, reserve, avbruddsfri." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_ElectricalConnection</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ElectricalSupplySystem</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00102 : Prosjektnedbrytning/områdekode || Angir kode til styringsobjektet som objektet befinner seg i (PNS)" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00103 : Objekt-ID || Unik objekt-ID for objektet. Eksempel er Banedata-ID, NVDB kode eller tilsvarende." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Objekt-ID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00104 : Funksjonell Lokasjon || Funksjonell lokasjon er et element i en funksjonsorientert systemnedbrytningsstruktur, og den representerer en funksjon som utføres på en geografisk plassering. Eksempel: sporveksel nr. 1 på Grindvoll stasjon." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FunksjonellLokasjon</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ActuatorApplication || from IFC documentation: Indicates application of actuator." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ActuatorTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActuatorApplication</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DAMPERACTUATOR"/>
              <xs:enumeration value="ENTRYEXITDEVICE"/>
              <xs:enumeration value="FIRESMOKEDAMPERACTUATOR"/>
              <xs:enumeration value="LAMPACTUATOR"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SUNBLINDACTUATOR"/>
              <xs:enumeration value="UNSET"/>
              <xs:enumeration value="VALVEPOSITIONER"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="ActuatorStatus || from IFC documentation: Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ActuatorTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ActuatorStatus</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DEMOLISH"/>
              <xs:enumeration value="EXISTING"/>
              <xs:enumeration value="NEW"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="TEMPORARY"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
