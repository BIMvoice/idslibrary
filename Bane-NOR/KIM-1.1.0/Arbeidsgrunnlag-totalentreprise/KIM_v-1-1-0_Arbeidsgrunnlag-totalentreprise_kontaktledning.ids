          </ids:baseName>
        </ids:property>
        <ids:property instructions="AssemblyPlace || from IFC documentation: Enumeration defining where the assembly is intended to take place, either in a factory, other offsite location or on the building site." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerTypeInformation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AssemblyPlace</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="FACTORY"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OFFSITE"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SITE"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="GlobalTradeItemNumber || from IFC documentation: The Global Trade Item Number (GTIN) is an identifier for trade items developed by GS1 (www.gs1.org)." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerTypeInformation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GlobalTradeItemNumber</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Manufacturer || from IFC documentation: The organization that manufactured and/or assembled the item." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerTypeInformation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Manufacturer</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ModelLabel || from IFC documentation: The descriptive model name of the product model (or product line) as assigned by the manufacturer of the manufactured item." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerTypeInformation</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
