              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OFFSITE"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SITE"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="BarCode || from IFC documentation: The identity of the bar code given to an occurrence of the product." dataType="IFCIDENTIFIER">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerOccurrence</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
