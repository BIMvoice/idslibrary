      <ids:requirements>
        <ids:property instructions="NOSSB00102 : Prosjektnedbrytning/områdekode || Angir kode til styringsobjektet som objektet befinner seg i (PNS)" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="CrossSectionArea || from IFC documentation: Total area of the cross section (or profile) of the object." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CrossSectionArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossSurfaceArea || from IFC documentation: Total gross area of the object, normally generated as perimeter * length + 2 * cross section area. It is the sum of OuterSurfaceArea + (2 x CrossSectionArea) and shall only be given, if the OuterSurfaceArea and CrossSectionArea cannot be established separately." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossSurfaceArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossVolume || from IFC documentation: Total gross volume of the object. Openings, recesses, enclosed objects and projections are not taken into account." dataType="IFCVOLUMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="GrossWeight || from IFC documentation: Total Gross Weight of the object without any add-on parts and not taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCMASSMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>GrossWeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Height || from IFC documentation: Characteristic height." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Height</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Length || from IFC documentation: The length of the object." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Length</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetVolume || from IFC documentation: Total net volume of the object, taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCVOLUMEMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetVolume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NetWeight || from IFC documentation: Total net weight of the object without add-on parts, taking into account possible processing features (cut-out's, etc.) or openings and recesses." dataType="IFCMASSMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NetWeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="OuterSurfaceArea || from IFC documentation: Total area of the extruded surfaces of the object (not taking into account the end cap areas), normally generated as perimeter * length." dataType="IFCAREAMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>OuterSurfaceArea</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="Width || from IFC documentation: The width of the object. Only given, if the object has constant thickness (prismatic)." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Qto_FootingBaseQuantities</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Width</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
