    <ids:specification name="19619 Sporveksel" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCELEMENTASSEMBLY</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>TURNOUTPANEL</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NOBN10202 : Skinneprofil || Tverrsnittsprofil av skinne som angir metervekt og geometrisk utforming. Kilde Bane NOR, Teknisk regelverk" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOBN_TurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RailProfile</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOBN10202 : Stigning || Tangens til vinkelen mellom senterlinjen i hovedsporet og tangenten til avvikssporets senterlinje ved sirkelbuens endepunkt i en sporveksel. Kilde: Bane NOR, Teknisk regelverk" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOBN_TurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SwitchAngle</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="NOSSB00102 : Prosjektnedbrytning/områdekode || Angir kode til styringsobjektet som objektet befinner seg i (PNS)" dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PSET_100168 : Status || from IFC documentation: Status of the element, predominately used in renovation or retrofitting projects. The status can be assigned to as &quot;New&quot; - element designed as new addition, &quot;Existing&quot; - element exists and remains, &quot;Demolish&quot; - element existed but is to be demolished,  &quot;Temporary&quot; - element will exists only temporary (like a temporary support structure)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BranchLineDirection || from IFC documentation: Describes the direction associated to the branch line of the turnout (deviated branch)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BranchLineDirection</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="LEFTDEVIATION"/>
              <xs:enumeration value="LEFT_LEFTDEVIATION"/>
              <xs:enumeration value="LEFT_RIGHTDEVIATION"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="RIGHTDEVIATION"/>
              <xs:enumeration value="RIGHT_LEFTDEVIATION"/>
              <xs:enumeration value="RIGHT_RIGHTDEVIATION"/>
              <xs:enumeration value="SYMETRIC"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="IsAccessibleByVehicle || from IFC documentation: Indicates whether the element is accessible by a vehicle or not." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsAccessibleByVehicle</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="IsSharedTurnout || from IFC documentation: Indicates if the turnout makes a connection to another infrastructure owner (for sharing costs)." dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsSharedTurnout</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="MaximumSpeedLimitOfDivergingLine || from IFC documentation: Maximum speed for diverging line that corresponds to the type of turnout and design constraints." dataType="IFCLINEARVELOCITYMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MaximumSpeedLimitOfDivergingLine</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="PercentShared || from IFC documentation: Percent of costs paid by the other infrastructure owner." dataType="IFCPOSITIVERATIOMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PercentShared</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TrackElementOrientation || from IFC documentation: Turnout panels can be placed in 2 mirror-symmetric directions in the field. To distinguish both ends of the turnout panel, a definition of an orientation system with respect to the panel is necessary. The orientation defines, if the panel is oriented in a way or opposite with respect to the direction of the alignment/stationing." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TrackElementOrientation</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="BACK"/>
              <xs:enumeration value="FRONT"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="TurnoutCurvedRadius || from IFC documentation: If turnout is curved, the main branch radius of curvature." dataType="IFCLENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TurnoutCurvedRadius</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TurnoutHeaterType || from IFC documentation: Defines the kind of turnout heater installed." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TurnoutHeaterType</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="ELECTRIC"/>
              <xs:enumeration value="GAS"/>
              <xs:enumeration value="GEOTHERMAL"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="TurnoutPointMachineCount || from IFC documentation: Count of point machines inside turnout panel." dataType="IFCCOUNTMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TurnoutPointMachineCount</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="TypeOfCurvedTurnout || from IFC documentation: Turnouts that are positioned in the curved part of the alignment." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeOfCurvedTurnout</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="CIRCULAR_ARC"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="STRAIGHT"/>
              <xs:enumeration value="TRANSITION"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="TypeOfDrivingDevice || from IFC documentation: Type of the driving device used for the turnout." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeOfDrivingDevice</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="ELECTRIC"/>
              <xs:enumeration value="HYDRAULIC"/>
              <xs:enumeration value="MANUAL"/>
              <xs:enumeration value="MIXED"/>
              <xs:enumeration value="MOTORISED"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="PNEUMATIC"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="TypeOfJunction || from IFC documentation: The turnout part of the continuous welded rail." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeOfJunction</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="ISOLATED_JOINT"/>
              <xs:enumeration value="JOINTED"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="UNSET"/>
              <xs:enumeration value="WELDED_AND_INSERTABLE"/>
              <xs:enumeration value="WELDED_AND_NOT_INSERTABLE"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="TypeOfTurnout || from IFC documentation: Type of turnout." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_ElementAssemblyTypeTurnoutPanel</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeOfTurnout</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="DERAILMENT_TURNOUT"/>
              <xs:enumeration value="DIAMOND_CROSSING"/>
              <xs:enumeration value="DOUBLE_SLIP_CROSSING"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SCISSOR_CROSSOVER"/>
              <xs:enumeration value="SINGLE_SLIP_CROSSING"/>
              <xs:enumeration value="SLIP_TURNOUT_AND_SCISSORS_CROSSING"/>
              <xs:enumeration value="SYMMETRIC_TURNOUT"/>
              <xs:enumeration value="THREE_WAYS_TURNOUT"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
