              <xs:enumeration value="OPPOSITETOSTATIONDIRECTION"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="STATIONDIRECTION"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
