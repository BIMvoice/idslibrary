            <ids:simpleValue>Pset_ElementComponentCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="BrakingLength || from IFC documentation: Length of the braking distance as a design parameter of the bumper occurrence." dataType="IFCPOSITIVELENGTHMEASURE">
