            <ids:simpleValue>RefPBS</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ContactWireNominalDrop || from IFC documentation: Vertical distance between the main catenary wire and the contact wire measured at a support point." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionSystemTypeOverheadContactlineSystem</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ContactWireNominalDrop</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ContactWireNominalHeight || from IFC documentation: Nominal distance from the top of the rail to the lower face of the contact wire, measured perpendicular to the track." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionSystemTypeOverheadContactlineSystem</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ContactWireNominalHeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ContactWireStagger || from IFC documentation: Lateral displacement of the contact wire to opposite sides of the track centre at successive supports." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionSystemTypeOverheadContactlineSystem</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ContactWireStagger</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="ContactWireUplift || from IFC documentation: Vertical upward movement of the contact wire due to the force produced from the pantograph." dataType="IFCNONNEGATIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_DistributionSystemTypeOverheadContactlineSystem</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ContactWireUplift</ids:simpleValue>
          </ids:baseName>
        </ids:property>
