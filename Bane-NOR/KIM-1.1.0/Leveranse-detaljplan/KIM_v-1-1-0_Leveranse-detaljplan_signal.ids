            <ids:simpleValue>Pset_RailwaySignalType</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>NumberOfLamps</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="RailwaySignalType || from IFC documentation: The type of railway signal, e.g. home signal, starting signal, shunting signal, level crossing signal." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwaySignalType</ids:simpleValue>
