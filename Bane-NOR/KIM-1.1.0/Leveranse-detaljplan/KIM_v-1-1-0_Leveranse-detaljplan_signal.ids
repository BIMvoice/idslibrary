              <xs:enumeration value="HOMESIGNAL"/>
              <xs:enumeration value="HUMPAUXILIARYSIGANL"/>
              <xs:enumeration value="HUMPSIGNAL"/>
              <xs:enumeration value="LEVELCROSSINGSIGNAL"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OBSTRUCTIONSIGNAL"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="REPEATINGSIGNAL"/>
              <xs:enumeration value="SHUNTINGSIGNAL"/>
              <xs:enumeration value="STARTINGSIGNAL"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="Weight || from IFC documentation: Total weight of object" dataType="IFCMASSMEASURE">
          <ids:propertySet>
