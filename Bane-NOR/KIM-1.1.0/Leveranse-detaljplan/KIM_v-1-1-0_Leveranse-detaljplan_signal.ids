    <ids:specification name="14412 Sporsikringsutstyr" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCDISCRETEACCESSORY</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>RAIL_MECHANICAL_EQUIPMENT</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property instructions="NONS10402 : Datakommunikasjonstype || Kommuniserer typen datatilkobling (kobber, fiber, trådløs)." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>NONS_DataConnection</ids:simpleValue>
