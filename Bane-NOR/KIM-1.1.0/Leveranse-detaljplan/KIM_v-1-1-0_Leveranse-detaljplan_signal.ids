          <ids:propertySet>
            <ids:simpleValue>Pset_RailwaySignalSighting</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SignalSightingAvailableDistance</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SignalSightingCombinedWithRepeater || from IFC documentation: Combined reading distance for the signal and any associated repeaters." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwaySignalSighting</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SignalSightingCombinedWithRepeater</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SignalSightingMinimum || from IFC documentation: Minimal distance in which the signal has to be readable." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwaySignalSighting</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SignalSightingMinimum</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SignalSightingPreferred || from IFC documentation: Preferred distance in which the signal shall be readable." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwaySignalSighting</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SignalSightingPreferred</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SignalSightingRouteIndicator || from IFC documentation: Required reading distance for the route indicator." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwaySignalSighting</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SignalSightingRouteIndicator</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="SignalViewingMinimumInFront || from IFC documentation: Smallest distance where the signal has to be readable (for train very close to the signal)." dataType="IFCPOSITIVELENGTHMEASURE">
          <ids:propertySet>
            <ids:simpleValue>Pset_RailwaySignalSighting</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
