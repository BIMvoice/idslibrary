    <ids:specification name="12504 Kombinert kontrollpanel" ifcVersion="IFC4X3_ADD2">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCUNITARYCONTROLELEMENT</ids:simpleValue>
