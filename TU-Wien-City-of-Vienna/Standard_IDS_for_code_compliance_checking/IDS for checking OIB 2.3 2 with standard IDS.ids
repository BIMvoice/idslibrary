<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>IDS for checking OIB 2.3 2 with standard IDS</title>
        <copyright>TU Wien</copyright>
        <date>2025-10-15</date>
    </info>
    <specifications>
        <specification name="OIB 2.3 2 - Buildings with an escape level of more than 22 m" ifcVersion="IFC4" description="graphical assistance!" instructions="The specifications relating to 2.3 Chapter 2 shall apply.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCLENGTHMEASURE">
                    <propertySet>
                        <simpleValue>WienBV_BuildingStoreySpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>EscapeLevel</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minExclusive value="22"/>
                        </xs:restriction>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 2/5 Safety stair case" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 22 m. Safety stair cases must fulfill the requirements according to 2/5.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>WienBV_SpaceSpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>SafetyStaircaseCategory</simpleValue>
                    </baseName>
                    <value>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="1" />
                        <xs:enumeration value="2" />
                    </xs:restriction>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 2/7/8 - Elevators" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 22 m. Elevators must fulfill the requirements according to 2/7/8.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>WienBV_SpaceSpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>SpaceName</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>Aufzug</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 2/10/1 - First and advanced fire extinguishing aid" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 22 m. First and advanced fire extinguishing aid must fulfill the requirements according to 2/10/1.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCFIRESUPPRESSIONTERMINAL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
            </requirements>
        </specification>
    </specifications>
</ids>