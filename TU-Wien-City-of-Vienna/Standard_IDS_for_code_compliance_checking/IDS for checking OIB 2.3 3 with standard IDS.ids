<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>IDS for checking OIB 2.3 3 with standard IDS</title>
        <copyright>TU Wien</copyright>
        <date>2025-10-15</date>
    </info>
    <specifications>
        <specification name="OIB 2.3 3 - Buildings with an escape level of no more than 32 m" ifcVersion="IFC4" description="graphical assistance!" instructions="The specifications relating to 2.3 Chapter 3 shall apply.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCLENGTHMEASURE">
                    <propertySet>
                        <simpleValue>WienBV_BuildingS</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>EscapeLevel</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minExclusive value="22"/>
                            <xs:maxInclusive value="32"/>
                        </xs:restriction>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 3/1/4 - Escape route" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 22 m and not more than 32 m. Each fire compartment on the above-ground floors must be connected to at least one safety staircase category 1.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>WienBV_SpaceSpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>SafetyStaircaseCategory</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>1</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>       
    </specifications>
</ids>