<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>IDS for checking OIB 2.3 4 with standard IDS</title>
        <copyright>TU Wien</copyright>
        <date>2025-10-15</date>
    </info>
    <specifications>
        <specification name="OIB 2.3 4 - Buildings with an escape level of more than 32 m and no more than 90 m" ifcVersion="IFC4" description="graphical assistance!" instructions="The specifications relating to 2.3 Chapter 4 shall apply.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCLENGTHMEASURE">
                    <propertySet>
                        <simpleValue>WienBV_BuildingStoreySpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>EscapeLevel</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minExclusive value="32"/>
                            <xs:maxInclusive value="90"/>
                        </xs:restriction>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 4/1/5 - Escape route" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 32 m and not more than 90 m. Each fire compartment on the above-ground floors must be connected to at least one safety staircase category 2.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>WienBV_SpaceSpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>SafetyStaircaseCategory</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>2</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 4/1/6 - Escape routes in buildings with an escape level of more than 60 m" ifcVersion="IFC4" description="graphical assistance!" instructions="Paragraph 4/1/6 of OIB 2.3 must be checked manually.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCLENGTHMEASURE">
                    <propertySet>
                        <simpleValue>WienBV_BuildingStoreySpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>EscapeLevel</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minExclusive value="60"/>
                            <xs:maxInclusive value="90"/>
                        </xs:restriction>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 4/2/1 b) - Safety staircase category 2" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 32 m and not more than 90 m. The safety staircase category 2 must fulfill the requirements according to 4/2/1 b).">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                <name>
                    <simpleValue>IFCSPACE</simpleValue>
                </name>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>WienBV_SpaceSpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>SafetyStaircaseCategory</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>2</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 4/4/1 - Preventive measures for effectively limiting vertical fire spread" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 32 m and not more than 90 m. An automatic extinguishing system with full protection according to 4/4/1 must be installed.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCFIRESUPPRESSIONTERMINAL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 4/4/2 - Preventive measures for effectively limiting vertical fire spread (1/2)" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 32 m and not more than 90 m. In apartments, an automatic extinguishing system must be installed in accordance with 4/4/2.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCFIRESUPPRESSIONTERMINAL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2.3 4/4/2 - Preventive measures for effectively limiting vertical fire spread (2/2)" ifcVersion="IFC4" description="graphical assistance!" instructions="Only to be checked if the escape level is more than 32 m and not more than 90 m. In apartments, an automatic extinguishing system must be installed in accordance with 4/4/2.">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                <name>
                    <simpleValue>IFCSPACE</simpleValue>
                </name>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>WienBV_SpaceSpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>NutzungseinheitGWR</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>Wohnung</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
    </specifications>
</ids>