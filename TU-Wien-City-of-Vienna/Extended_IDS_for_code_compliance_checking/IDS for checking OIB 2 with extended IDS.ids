                        </propertySet>
                        <baseName>
                            <simpleValue>IDNextDoor</simpleValue>
                        </baseName>
                    </property>
                </partOf>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>WienBV_SpaceSpecific</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>SpaceName</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>offener Laubengang</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2 - Table 2a - 1.1 Walls of staircases in above-ground storeys (GK2)" ifcVersion="IFC4" description="fully automated!">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
                <partOf relation="IFCRELSPACEBOUNDARY">
                    <entity>
                        <name>
                            <simpleValue>IFCSPACE</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLABEL">
                        <propertySet>
                            <simpleValue>WienBV_SpaceSpecific</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>StaircaseType</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>OIB2Tab2ab</simpleValue>
                        </value>
                    </property>
                </partOf>
                <partOf>
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDING</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLABEL">
                        <propertySet>
                            <simpleValue>WienBV_BuildingSpecific</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>BuildingClass</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>GK2</simpleValue>
                        </value>
                    </property>
                </partOf>
                <partOf>
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLOGICAL">
                        <propertySet>
                            <simpleValue>Pset_BuildingStoreyCommon</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>AboveGround</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>true</simpleValue>
                        </value>
                    </property>
                </partOf>
            </applicability>
            <requirements>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>FireRating</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="REI 180" />
                            <xs:enumeration value="REI 120" />
                            <xs:enumeration value="REI 90" />
                            <xs:enumeration value="REI 60" />
                            <xs:enumeration value="REI 30" />
                            <xs:enumeration value="EI 180" />
                            <xs:enumeration value="EI 120" />
                            <xs:enumeration value="EI 90" />
                            <xs:enumeration value="EI 60" />
                            <xs:enumeration value="EI 30" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="OIB 2 - Table 2a - 1.1 Walls of staircases in above-ground storeys (GK3 + GK4)" ifcVersion="IFC4" description="fully automated!">
            <applicability>
