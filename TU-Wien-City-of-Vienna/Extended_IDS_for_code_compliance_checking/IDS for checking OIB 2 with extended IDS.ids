                    </propertySet>
                    <baseName>
                        <simpleValue>Compartmentation</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>true</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2 3/1/6 - Openings in walls or slabs forming fire compartments" ifcVersion="IFC4" description="graphical assistance!" instructions="Any openings in walls or slabs that form fire compartments must fulfil the requirements according to 3/1/6.">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCOPENING</simpleValue>
                    </name>
                </entity>
                <partOf relation="IFCRELVOIDSELEMENT IFCRELFILLSELEMENT">
                    <entity>
                        <name>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="IFCWALL" />
                                <xs:enumeration value="IFCSLAB" />
                            </xs:restriction>
                        </name>
                    </entity>
                    <property dataType="IFCBOOLEAN">
                        <propertySet>
                            <xs:restriction base="xs:string">
                                <xs:pattern value="Pset_.*Common"></xs:pattern>
                            </xs:restriction>
                        </propertySet>
                        <baseName>
                            <simpleValue>Compartmentation</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>true</simpleValue>
                        </value>
                    </property>
                </partOf>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2 3/4/2 - Shafts, channels, pipes, and other fixtures" ifcVersion="IFC4" description="graphical assistance!" instructions="If shafts connect several floors, the walls must be constructed as partition walls in accordance with Table 1b.">
            <applicability>
                 <entity>
                    <name>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="IFCWALL" />
                            <xs:enumeration value="IFCCOVERING" />
                        </xs:restriction>
                    </name>
                </entity>
                <partOf relation="IFCRELSPACEBOUNDARY">
                    <entity>
                        <name>
                            <simpleValue>IFCSPACE</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLABEL">
                        <propertySet>
                            <simpleValue>WienBV_SpaceSpecific</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>SpaceName</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>Schacht</simpleValue>
                        </value>
                    </property>
                </partOf>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2 3/6/1 - Elevators" ifcVersion="IFC4" description="graphical assistance!" instructions="The requirements according to 3/6/1 concerning elevators connecting fire compartments must be fulfilled.">
            <applicability>
                <entity>
                    <name>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="IFCWALL" />
                            <xs:enumeration value="IFCSLAB" />
                        </xs:restriction>
                    </name>
                </entity>
                <partOf relation="IFCRELSPACEBOUNDARY">
                    <entity>
                        <name>
                            <simpleValue>IFCSPACE</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLABEL">
                        <propertySet>
                            <simpleValue>WienBV_SpaceSpecific</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>SpaceName</simpleValue>
                        </baseName>
                        <value>
                            <xs:restriction base="xs:string">
                                <xs:pattern value="Aufzug*"/>
                            </xs:restriction>
                        </value>
                    </property>
                </partOf>
                <property dataType="IFCBOOLEAN">
                    <propertySet>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="Pset_.*Common"/>
                        </xs:restriction>
                    </propertySet>
                    <baseName>
                        <simpleValue>Compartmentation</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>true</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2 3/9/2 - Rooms with an increased fire risk (1/3)" ifcVersion="IFC4" description="partially automated!" instructions="The requirements according to 3/9/2 for walls and slabs bounding rooms with an increased fire risk must be fulfilled.">
            <applicability>
                 <entity>
                    <name>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="IFCWALL" />
                            <xs:enumeration value="IFCSLAB" />
                        </xs:restriction>
                    </name>
                </entity>
                <partOf relation="IFCRELSPACEBOUNDARY">
                    <entity>
                        <name>
                            <simpleValue>IFCSPACE</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLABEL">
                        <propertySet>
                            <simpleValue>WienBV_SpaceSpecific</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>SpaceName</simpleValue>
                        </baseName>
                        <value>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="Abfallsammelraum" />
                                <xs:enumeration value="Brennstofflager" />
                                <xs:enumeration value="Batterieraum" />
                                <xs:enumeration value="Müllraum" />
                                <xs:enumeration value="Heizlager" />
                            </xs:restriction>
                        </value>
                    </property>
                </partOf>
            </applicability>
            <requirements>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="Pset_.*Common"/>
                        </xs:restriction>
                    </propertySet>
                    <baseName>
                        <simpleValue>FireRating</simpleValue>
                    </baseName>
                    <value>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="EI 90" />
                                <xs:enumeration value="EI 120" />
                                <xs:enumeration value="EI 180" />
                                <xs:enumeration value="REI 90" />
                                <xs:enumeration value="REI 120" />
                                <xs:enumeration value="REI 180" />
                            </xs:restriction>
                        </value>
                </property>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="Pset_.*Common"/>
                        </xs:restriction>
                    </propertySet>
                    <baseName>
                        <simpleValue>SurfaceSpreadOfFlame</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>A2</simpleValue>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="OIB 2 3/9/2 - Rooms with an increased fire risk (2/3)" ifcVersion="IFC4" description="partially automated!" instructions="The requirements according to 3/9/2 for coverings bounding rooms with an increased fire risk must be fulfilled.">
