                </property>
            </requirements>
        </specification>
        <specification name="OIB 2 3/9/2 - Rooms with an increased fire risk (3/3)" ifcVersion="IFC4" description="graphical assistance!" instructions="The requirements according to 3/9/2 for openings bounding rooms with an increased fire risk must be fulfilled.">
