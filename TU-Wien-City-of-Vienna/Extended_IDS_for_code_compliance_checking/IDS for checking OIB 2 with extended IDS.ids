        <specification name="OIB 2 3/12/1 - Smoke extraction from underground floors" ifcVersion="IFC4" description="graphical assistance!" instructions="Suitable precautions according to 3/12/1 must be taken to allow smoke to escape to the outside.">
            <applicability>
                <partOf>
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLOGICAL">
                        <propertySet>
                            <simpleValue>Pset_BuildingStoreyCommon</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>AboveGround</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>false</simpleValue>
                        </value>
                    </property>
                </partOf>
            </applicability>
            <requirements>
            </requirements>
        </specification>
        <specification name="OIB 2 5/3/6 - Corridors, stairs, and doors along escape routes" ifcVersion="IFC4" description="graphical assistance!" instructions="The requirements according to 5/3/6 for windows and doors opening onto open arcades must be fulfilled.">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
                <partOf relation="IFCRELSPACEBOUNDARY">
                    <entity>
