<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS ids.xsd">
  <!-- INFO: Export generated by BIMQ. Further information available at https://www.bimq.de -->
  <ids:info>
    <ids:title>Statsbygg TEMPLATE: SIMBA 2.1 (RELEASED - NO CHANGES ALLOWED)</ids:title>
    <ids:version>2.1</ids:version>
    <ids:description>[EN] SIMBA 2.1 requires deliverables on IFC4. It applies to all projects after 2022-07-01. 
[NO] SIMBA 2.1 krever modelleveranser på IFC4. Gjelder for alle nye prosjekter etter 2022-07-01.</ids:description>
    <ids:author>frode.mohus@statsbygg.no</ids:author>
    <ids:date>2023-09-20</ids:date>
    <ids:purpose>Coordinated design (B4.1 Detaljprosjekt) .1 | Coordinated design (B4.1 Detaljprosjekt) .5 | Coordinated design (B4.1 Detaljprosjekt) .9</ids:purpose>
    <ids:milestone>Coordinated design (B4.1 Detaljprosjekt)</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="001 Project" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001- : ProjectNumber || Statsbygg official Project Number (seven digits)">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-001 : ProjectName || Statsbygg official Project Name">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="002 Site" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001- : SiteName || The official name of the property [no: Eiendomsnavn]">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002- : SiteNumber || The site may additionally have a Statsbygg “property number” [no. Statsbyggs Eiendomsnummer] if so required in the project. If required this naming shall be captured in IfcSite.Longname.">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0003- : LandTitleNumber || The site shall contain the official ID of the Cadastre [no:Matrikkel]  - the Cadastral Number.">
          <ids:name>
            <ids:simpleValue>LandTitleNumber</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="003 Building" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001- : BuildingName || A descriptive name of the building volume represented by the building object, e.g. &quot;Block D&quot;.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002- : BuildingNumber || Statsbygg's &quot;Byggnummer&quot; [en: Building number]">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="004 Building Storey" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDINGSTOREY</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001- : BuildingStoreyNumber || The storey names shall be an integer number starting from “1” at the lowest floor level and incrementing by one for each floor level – i.e. storey numbers must not be negative even for storeys below ground.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002- : BuildingStoreyName || Storey name according to Statsbygg document “PA0603” type naming scheme (if so required in the project).">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="005 Spatial Zone" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || GFA = Gross Floor Area [no: BTA = &quot;bruttoareal&quot; according to NS 3940]  UA = Usable Area (total area within a storey, excluding external wall footprint area) [no: &quot;bruksareal&quot; according to NS 3940]  There may be additional types of spatial zones as defined in projects.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10008 : DuplicateOwnedBy || Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>DuplicateOwnedBy</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12002 : HasCriticalityClassificationReq || National object and infrastructure criticality classification: Defines a space/zone to  highlight design focus on specific classified object according to criticality level used in the Norwegian Security Act" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCriticalityClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12003 : HasPersonnelAuthorizationReq || Security space/zone classification: Defines security level (specified access to spaces/zones) according to the defined authorization levels of personnel categories used (typically project or client specific levels)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasPersonnelAuthorizationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12004 : HasRobustnessClassificationReq || Security space/zone classification: Defines a robustness space/zone according to specified use and load, implying requirements for specific structural and technical measures to make the space/zone sufficiently robust according to the intentions" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasRobustnessClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12005 : HasSecurityCertifiedEscapeRouteReq || Security space/zone classification: A space/zone indicating (fire) escape routes that are certified by the security design to ensure that escape takes place by traversing from higher level security zones to lower or same level security zones only" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityCertifiedEscapeRouteReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12006 : HasSecurityConversationClassificationReq || (Main) Security space/zone classification: Defines security level (specified access to spaces/zones) according to the information classification markings used" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityConversationClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12007 : HasSecurityStorageClassificationReq || (Main) Security space/zone classification: Defines security level (specified access to spaces/zones) according to the information classification markings used" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityStorageClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12008 : HasSecurityEvacuationReq || Security space/sone classification: Indicate possibility and need of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityEvacuationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12010 : HasUnwantedIncidentDetectionReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are detected,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12011 : HasUnwantedIncidentVerificationReq || Security space/zone classification: Defines a space/zone where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented to security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12012 : HasUnwantedIncidentWarningReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by a warning system, by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12013 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures required to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12014 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12015 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12016 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12017 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12018 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12019 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12020 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12021 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityRequirementsReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12022 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12023 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="005 Zone" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-004 : ZoneName || Name for a zone. Used to specify type of zone. &#10;E.g. Security zone, fire safety zone, air handling zone, rental zone etc.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-004 : Description || Any further description of the zone.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0003-002 : LongName || Long name for a zone, used for informal purposes. It should be used, if available, in conjunction with the inherited Name attribute.">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NOSSB12002 : HasCriticalityClassificationReq || National object and infrastructure criticality classification: Defines a space/zone to  highlight design focus on specific classified object according to criticality level used in the Norwegian Security Act" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCriticalityClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12003 : HasPersonnelAuthorizationReq || Security space/zone classification: Defines security level (specified access to spaces/zones) according to the defined authorization levels of personnel categories used (typically project or client specific levels)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasPersonnelAuthorizationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12004 : HasRobustnessClassificationReq || Security space/zone classification: Defines a robustness space/zone according to specified use and load, implying requirements for specific structural and technical measures to make the space/zone sufficiently robust according to the intentions" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasRobustnessClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12005 : HasSecurityCertifiedEscapeRouteReq || Security space/zone classification: A space/zone indicating (fire) escape routes that are certified by the security design to ensure that escape takes place by traversing from higher level security zones to lower or same level security zones only" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityCertifiedEscapeRouteReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12006 : HasSecurityConversationClassificationReq || (Main) Security space/zone classification: Defines security level (specified access to spaces/zones) according to the information classification markings used" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityConversationClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12007 : HasSecurityStorageClassificationReq || (Main) Security space/zone classification: Defines security level (specified access to spaces/zones) according to the information classification markings used" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityStorageClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12008 : HasSecurityEvacuationReq || Security space/sone classification: Indicate possibility and need of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityEvacuationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12010 : HasUnwantedIncidentDetectionReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are detected,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12011 : HasUnwantedIncidentVerificationReq || Security space/zone classification: Defines a space/zone where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented to security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12012 : HasUnwantedIncidentWarningReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by a warning system, by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12013 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures required to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12014 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12015 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12016 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12017 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12018 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12019 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12020 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12021 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityRequirementsReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12022 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12023 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="006 Space" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPACE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-005 : SpaceFunctionNumber || Spatial Function Number (no: &quot;Romfunksjonsnummer&quot;) according to the project specific spatial program, typically denoted by a main function number, a sub function number, and a sequential room number, dot delimited, e.g. 03.05.004.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-005 : Description || Any further, more specified description of the spatial function (no: &quot;Rombetegnelse&quot;) as named in the LongName field, e.g. &quot;for 20 persons&quot;.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0003-001 : SpatialFunctionCode || 3-digit spatial code and name (no: &quot;Romnavn&quot;) according to Norwegian Standard NS3457-4:2015 Classification of construction works - Part 4: Spatial functions. Syntax according to the standard, i.e. first the 3-digit code followed by a space and then the name, e.g. &quot;212 Møterom&quot; (en: 212 Meeting room). &#10;&#10;Special case: Gross Floor Area (GFA) objects shall specifically be denoted &quot;BTA&quot; (no: &quot;bruttoareal&quot;) in this field, optionally followed by a space and a further specification, e.g. &quot;BTA Floor 3&quot;.">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NOSSB12002 : HasCriticalityClassificationReq || National object and infrastructure criticality classification: Defines a space/zone to  highlight design focus on specific classified object according to criticality level used in the Norwegian Security Act" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCriticalityClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12003 : HasPersonnelAuthorizationReq || Security space/zone classification: Defines security level (specified access to spaces/zones) according to the defined authorization levels of personnel categories used (typically project or client specific levels)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasPersonnelAuthorizationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12004 : HasRobustnessClassificationReq || Security space/zone classification: Defines a robustness space/zone according to specified use and load, implying requirements for specific structural and technical measures to make the space/zone sufficiently robust according to the intentions" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasRobustnessClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12005 : HasSecurityCertifiedEscapeRouteReq || Security space/zone classification: A space/zone indicating (fire) escape routes that are certified by the security design to ensure that escape takes place by traversing from higher level security zones to lower or same level security zones only" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityCertifiedEscapeRouteReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12006 : HasSecurityConversationClassificationReq || (Main) Security space/zone classification: Defines security level (specified access to spaces/zones) according to the information classification markings used" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityConversationClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12007 : HasSecurityStorageClassificationReq || (Main) Security space/zone classification: Defines security level (specified access to spaces/zones) according to the information classification markings used" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityStorageClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12008 : HasSecurityEvacuationReq || Security space/sone classification: Indicate possibility and need of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityEvacuationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12010 : HasUnwantedIncidentDetectionReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are detected,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12011 : HasUnwantedIncidentVerificationReq || Security space/zone classification: Defines a space/zone where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented to security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12012 : HasUnwantedIncidentWarningReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by a warning system, by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12013 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures required to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12014 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12015 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12016 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12017 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12018 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12019 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12020 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12021 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityRequirementsReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12022 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12023 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="200 Covering" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability/>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001  Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="200 Covering Ceiling" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCCOVERING</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>CEILING</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001&#10;&#10;Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10207 : HasThermalRequirements || Kommuniserer at rommet/sonen har krav til termiske egenskaper for (TRUE/ FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_ReqTriggers</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasThermalRequirements</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="200 Covering Flooring" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCCOVERING</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>FLOORING</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001  Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10207 : HasThermalRequirements || Kommuniserer at rommet/sonen har krav til termiske egenskaper for (TRUE/ FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_ReqTriggers</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasThermalRequirements</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="200 Wall" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability/>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001&#10;&#10;Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10008 : DuplicateOwnedBy || Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>DuplicateOwnedBy</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10207 : HasThermalRequirements || Kommuniserer at rommet/sonen har krav til termiske egenskaper for (TRUE/ FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_ReqTriggers</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasThermalRequirements</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistance</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="200 760 771 Slab" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability/>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001&#10;&#10;Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10008 : DuplicateOwnedBy || Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>DuplicateOwnedBy</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="234 Door" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability/>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001&#10;&#10;Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10207 : HasThermalRequirements || Kommuniserer at rommet/sonen har krav til termiske egenskaper for (TRUE/ FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_ReqTriggers</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasThermalRequirements</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="234 Window" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability/>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001&#10;&#10;Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10207 : HasThermalRequirements || Kommuniserer at rommet/sonen har krav til termiske egenskaper for (TRUE/ FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_ReqTriggers</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasThermalRequirements</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="260 Roof" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCROOF</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001  Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10008 : DuplicateOwnedBy || Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>DuplicateOwnedBy</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10207 : HasThermalRequirements || Kommuniserer at rommet/sonen har krav til termiske egenskaper for (TRUE/ FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_ReqTriggers</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasThermalRequirements</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="297 Security separator" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDINGELEMENTPROXY</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>USERDEFINED</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001&#10;&#10;Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NOSSB12102 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12103 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12104 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12105 : HasUnwantedIncidentDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are detected,  by means of alarm system components, video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12106 : HasUnwantedIncidentVerificationReq || Security separator classification: Defines a separator (typically vertical or horizontal)  where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12107 : HasUnwantedIncidentWarningReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unwanted incidents through the separator are notified by a warning,  by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12108 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12109 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12110 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12111 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12112 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12113 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12114 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12115 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures requried to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="298 Security section and compartment" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDINGELEMENTPROXY</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>USERDEFINED</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001&#10;&#10;Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NOSSB12002 : HasCriticalityClassificationReq || National object and infrastructure criticality classification: Defines a space/zone to  highlight design focus on specific classified object according to criticality level used in the Norwegian Security Act" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCriticalityClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12003 : HasPersonnelAuthorizationReq || Security space/zone classification: Defines security level (specified access to spaces/zones) according to the defined authorization levels of personnel categories used (typically project or client specific levels)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasPersonnelAuthorizationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12004 : HasRobustnessClassificationReq || Security space/zone classification: Defines a robustness space/zone according to specified use and load, implying requirements for specific structural and technical measures to make the space/zone sufficiently robust according to the intentions" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasRobustnessClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12005 : HasSecurityCertifiedEscapeRouteReq || Security space/zone classification: A space/zone indicating (fire) escape routes that are certified by the security design to ensure that escape takes place by traversing from higher level security zones to lower or same level security zones only" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityCertifiedEscapeRouteReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12006 : HasSecurityConversationClassificationReq || (Main) Security space/zone classification: Defines security level (specified access to spaces/zones) according to the information classification markings used" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityConversationClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12007 : HasSecurityStorageClassificationReq || (Main) Security space/zone classification: Defines security level (specified access to spaces/zones) according to the information classification markings used" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityStorageClassificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12008 : HasSecurityEvacuationReq || Security space/sone classification: Indicate possibility and need of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityEvacuationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12010 : HasUnwantedIncidentDetectionReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are detected,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12011 : HasUnwantedIncidentVerificationReq || Security space/zone classification: Defines a space/zone where unwanted incidents are verified,  by means of technical systems for video surveillance (CCTV) and/or manually and procedure-oriented to security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentVerificationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12012 : HasUnwantedIncidentWarningReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by a warning system, by alarm bells locally, alarm transfer to monitoring station or security guard center etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentWarningReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12013 : HasUnwantedIncidentDelayReq || Security space/zone classification: Defines a space/zone where unwanted incidents in the zone are notified by delay requirements, by defense in depth and/or a combination of measures required to avoid an unwanted incident." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySectionAndCompartment</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnwantedIncidentDelayReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12014 : HasBulletResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be bullet resistant." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12015 : HasEavesdroppingResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where eavesdropping through the separator is limited or blocked (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, design of ventilation ducts etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12016 : HasUnauthorizedAccessDetectionReq || Security separator classification: Defines a separator (typically vertical or horizontal) where unauthorized access through the separator is detected, automatically by means of electronic access control systems, glass break detectors etc, or manually and procedure-oriented by ensuring unobstructed visual sight lines, good visibilty measures etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasUnauthorizedAccessDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12017 : HasVisionAvoidanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where vision through the separator is limited or blocked (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12018 : HasBlastResistanceReq || Security Separator  classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against the consequences of explosive blasts (typically concrete walls, landscapeing barrieres etc)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasBlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12019 : HasCBRNeResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attemps by chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasCBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12020 : HasEMPResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasEMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12021 : HasSecurityReq || Security separator classification: A separator that has some kind of security requirements without further specifying them in the model (typically at an early project stage, when actual requirements are given in a separate report, as a preliminary notice for new use cases, to avoid disclosing actual requirements in the model, or to indicate a need for interdisciplinary coordination)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasSecurityRequirementsReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12022 : HasIntrusionResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts (typically delay or impede intrusions by electronic access control systems, instrusion alarm systems, video surveillance systems (CCTV), or lock systems, fencing, concrete walls, reinforced light walls, landscape barriers, security bollards, security furnishing etc." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasIntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12023 : HasVehicleResistanceReq || Security separator classification: Defines a separator (typically vertical or horizontal) where the separator is constructed to be resistant against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecuritySeparator</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasVehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12202 : AccessControlReq || Defines that access control systems are used as a means to ensure security related requirement(s), and requirements given for the access control system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessControlReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12203 : AlarmSystemReq || Defines that alarm systems are used as a means to ensure security related requirement(s), and requirements given for the alarm system (for example assault or incident alarm system)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AlarmSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12204 : BlastResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid and/or reduce the consequenses of explosive blasts (typically concrete walls, landscapeing barrieres, certain minimum distances etc)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BlastResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12205 : BulletResistanceReq || Defines bulletproofing requirements for zones, spatialzones and/or separators (typically walls, windows, doors, vision of sight etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BulletResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12206 : CBRNeResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to attacks with chemical (C), biological (B), radiological (R), nuclear (N), explosive (e) materials (typically by using technical control systems such as detection alarms, or in the design of ventilation systems, walls etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CBRNeResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12207 : CriticalityClassificationReq || Defined criticality level, typically VERY_CRITICAL, CRITICAL, IMPORTANT, NOT_CLASSIFIED, according the Norwegian Security Act" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>CriticalityClassificationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="VERY_CRITICAL"/>
              <xs:enumeration value="CRITICAL"/>
              <xs:enumeration value="IMPORTANT"/>
              <xs:enumeration value="NOT_CRITICAL"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12208 : EavesdroppingResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against eavesdropping  (typically with measures like sound attenuating constructions, sound silencers, caulking products, calculated distances, the design of ventilation ducts/systems etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EavesdroppingResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12209 : EMPResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant against electromagnetic pulses (EMP) (typically by overvoltage protection, Faraday cages, equipment redundency  etc." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EMPResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12210 : GlassBreakDetectionReq || Defines glass break detection type/requirements given to glass to avoid unwanted incidents." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlassBreakDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12211 : IncidentDetectionType || Defined incident detection type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentDetectionType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12212 : IncidentVerificationType || Defined incident verification type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentVerificationType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12213 : IncidentWarningType || Defined incident warning type, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IncidentWarningType</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12214 : IntrusionAlarmReq || Defines that intrusion alarm systems are used as a means to ensure security related requirement(s) and specific requirments related to the functioning of the intrusion alarm." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionAlarmReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12215 : IntrusionResistanceReq || Defines requirements given to zones, spatialzones and/or separators to be resistant to intrusion and intrusion attempts by people and/or people using tools to break into a zone or through a separator. Intrusion resistance is typically indicated using classifications on doors, windows and walls and/or by means of access control systems (for example electronic access control systems, glass break detectors, video surveillance systems (CCTV), lock systems, fencing, concrete walls, reinforced light walls, landscap barriers, security furnishing, security bollards, visual sight lines, good visibilty measures, lack of vegetation, defence in depth etc). For example on classification see Forsvarsbygg &quot;Sikringshåndboka&quot; (SK1, SK2, ..) or 1627:2021 (RC 1, RC 2 ..)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IntrusionResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12216 : MotionDetectionReq || Defines performance requirements given to zones, spatialzones and/or separators for motion detection systems to ensure security related requirement(s) (volum/areas where motion needs to be detected, times where motion detection needs to be detected, detection of motion speed and direction etc.)" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MotionDetectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : PersonnelAutrorizationLevel || Defined authorization level of personnel, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PersonnelAutrorizationLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12217 : RobustnessClass || Defined robustness class, typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RobustnessClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12218 : SecurityCertifiedEscapeRouteClass || Defined lowest security level that is allowed to use this escape route , typically project or client specific classes" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityCertifiedEscapeRouteClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12219 : SecurityConversationClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityConversationClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12220 : SecurityEvacuationReq || Security classification: Indicates possibility of evacuating due to a security event (not fire), e.g. back-office, own escape route, path to assembly etc. See Forsvarsbygg &quot;Sikringshåndboka&quot; for guidelines to security evacuation zones." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityEvacuationReq</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12221 : SecurityProtectionReq || Security classification: Requirements for protection against one or more defined security related threats (typically vision into the zone, eavesdropping, shooting, blast effects etc. Relevant attributes or properties for such a zone must be given to indicate type(s)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityProtectionReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12222 : SecurityStorageClassification || (Main) Security classification: Defines security level according to the information classification markings used" datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SecurityStorageClassification</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="COSMIC_TOP_SECRET"/>
              <xs:enumeration value="NATO_SECRET"/>
              <xs:enumeration value="NATO_CONFIDENTIAL"/>
              <xs:enumeration value="NATO_RESTRICTED"/>
              <xs:enumeration value="NATO_UNCLASSIFIED"/>
              <xs:enumeration value="NOTDEFINED"/>
              <xs:enumeration value="USERDEFINED"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB12223 : SensitiveInformationReq || Defines security level according to userdefined classification requirements." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SensitiveinformationReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12224 : VehicleResistanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences against intrusion attempts by vehicles (typically by fencing, railings, bollards, road blockers, terrain design elements, security furnishing etc.) For example on classification see BSI Publicly Available Specification (PAS) 68." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VehicleResistanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12225 : VideoSurveillanceReq || Defines that video surveillance systems are used as a means to ensure security related requirement(s) and specific requirements related to the function of the video surveillance system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VideoSurveillanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12226 : VisionAvoidanceReq || Defines requirements given to zones, spatialzones and/or separators to avoid, delay and/or reduce consequences of vision (typically with measures like wall structures, venetian blinds, curtains, light blocking glass or glazed glass etc)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisionAvoidanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12227 : VisualLineOfSight || Defines that visual line of sight is used as a means to ensure security related requirement(s) and specific requirements related to the function of visual line of sight." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VisualLineOfSight</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB12228 : VoiceEvacuationSystemReq || Defines that voice alarm systems are used as a means to ensure security related requirement(s), and requirements given for the voice alarm/evacuation system." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NOSSB_SecurityMeassures</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>VoiceEvacuationSystemReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
