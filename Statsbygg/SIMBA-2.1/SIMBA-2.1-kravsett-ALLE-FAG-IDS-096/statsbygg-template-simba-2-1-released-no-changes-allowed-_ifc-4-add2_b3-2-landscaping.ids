        </ids:attribute>
        <ids:property instructions="NONS10008 : DuplicateOwnedBy || Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
