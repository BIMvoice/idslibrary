      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCTANK</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001  Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="0ac7c700d21011e1800000215ad4efdf : EffectiveCapacity || The total effective or actual volumetric capacity of the tank." datatype="IFCVOLUMEMEASURE" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_TankTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EffectiveCapacity</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="d2c08400d20f11e1800000215ad4efdf : AccessType || Defines the types of access (or cover) to a tank that may be specified.&#10;&#10;Note that covers are generally specified for rectangular tanks. For cylindrical tanks, access will normally be via a manhole." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_TankTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AccessType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="LOOSECOVER"/>
              <xs:enumeration value="MANHOLE"/>
              <xs:enumeration value="NONE"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SECUREDCOVER"/>
              <xs:enumeration value="SECUREDCOVERWITHMANHOLE"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="e0760980d20f11e1800000215ad4efdf : StorageType || Defines the general material category intended to be stored." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_TankTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>StorageType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="FUEL"/>
              <xs:enumeration value="ICE"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OIL"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="POTABLEWATER"/>
              <xs:enumeration value="RAINWATER"/>
              <xs:enumeration value="UNSET"/>
              <xs:enumeration value="WASTEWATER"/>
              <xs:enumeration value="WATER"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="eff55280d20f11e1800000215ad4efdf : NominalLengthOrDiameter || The nominal length or, in the case of a vertical cylindrical tank, the nominal diameter of the tank." datatype="IFCPOSITIVELENGTHMEASURE" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_TankTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>NominalLengthOrDiameter</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="f7b4f700d20f11e1800000215ad4efdf : NominalWidthOrDiameter || The nominal width or, in the case of a horizontal cylindrical tank, the nominal diameter of the tank.&#10;&#10;Note: Not required for a vertical cylindrical tank." datatype="IFCPOSITIVELENGTHMEASURE" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_TankTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>NominalWidthOrDiameter</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="fedc0500d20f11e1800000215ad4efdf : NominalDepth || The nominal depth of the tank.&#10;&#10;Note: Not required for a horizontal cylindrical tank." datatype="IFCPOSITIVELENGTHMEASURE" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_TankTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>NominalDepth</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10010 : IsProcured || Kommuniserer at produktet som objektet representerer er innkjøpt. Selv om objektet ikke er ferdig prosjektert skal geometri og egenskaper være representative for det innkjøpte produktet. Denne kan brukes som alternativ til kode under ConstructedStatus som angir om produktet som objektet representerer er innkjøpt." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IsProcured</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10102 : RefString || Sammensatt TFM-ID (kodestreng) i byggeierens foretrukne format. Det skal avtales om denne kreves, og hvilket format den skal ha. I IFC bør dette ligge i IfcXxxxxx.Tag eller i egenskapen «Reference» i Pset  IfcXxxxxxCommon." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
