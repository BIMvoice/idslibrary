        </ids:property>
        <ids:property instructions="3b0b6780d20811e1800000215ad4efdf : LoadBearing || Indicates whether the object is intended to carry loads (TRUE) or not (FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
