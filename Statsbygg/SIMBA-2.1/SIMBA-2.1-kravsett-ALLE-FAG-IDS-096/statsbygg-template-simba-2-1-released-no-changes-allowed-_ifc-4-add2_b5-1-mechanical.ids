          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="QUICK"/>
              <xs:enumeration value="STANDARD"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
