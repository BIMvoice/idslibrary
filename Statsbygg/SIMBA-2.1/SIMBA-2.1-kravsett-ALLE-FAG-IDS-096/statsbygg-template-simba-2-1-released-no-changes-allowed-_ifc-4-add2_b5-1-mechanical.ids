        <ids:property instructions="1d79d600d1e711e1800000215ad4efdf : SprinklerType || Identifies the predefined types of sprinkler  from which the type required may be set." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_FireSuppressionTerminalTypeSprinkler</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>SprinklerType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="CEILING"/>
              <xs:enumeration value="CONCEALED"/>
              <xs:enumeration value="CUT-OFF"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="PENDANT"/>
              <xs:enumeration value="RECESSEDPENDANT"/>
              <xs:enumeration value="SIDEWALL"/>
              <xs:enumeration value="UNSET"/>
              <xs:enumeration value="UPRIGHT"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="3da99500d1e711e1800000215ad4efdf : Response || Identifies the predefined methods of sprinkler response from which that required may be set." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
