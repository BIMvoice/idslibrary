              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="SIDEWALLHIGH"/>
              <xs:enumeration value="SIDEWALLLOW"/>
              <xs:enumeration value="SILL"/>
              <xs:enumeration value="UNSET"/>
