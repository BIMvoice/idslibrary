        </ids:property>
        <ids:property instructions="NOSSB10003 : HasFireSafetyReq || Communicates the object has fire safety requirements. Activates checking of object according to NOSSB_Fire. Applies to elements." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
