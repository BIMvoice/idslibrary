          <ids:propertySet>
            <ids:simpleValue>NOSSB_EnvironmentalCircularity</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IsReusable</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
