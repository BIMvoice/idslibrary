      <ids:requirements>
        <ids:property instructions="84899180d1cb11e1800000215ad4efdf : StructuralClass || The structural class defined for the concrete structure (e.g. '1')." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>StructuralClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="96390dc443fd41d88cb6aca86dce4993 : StrengthClass || Classification of the concrete strength in accordance with the concrete design code which is applied in the project." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>StrengthClass</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="9bee0bf72ad34a66bef57b71b7ca175b : ExposureClass || Classification of exposure to environmental conditions, usually specified in accordance with the concrete design code which is applied in the project." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_ConcreteElementGeneral</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ExposureClass</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="A"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="NOSSB10007 : HasEnvironmentalReq || Communicates the object has Environmental Documentation Requirements. Activates checking of object according to required RIM-properies." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
