          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10102 : RefString || Sammensatt TFM-ID (kodestreng) i byggeierens foretrukne format. Det skal avtales om denne kreves, og hvilket format den skal ha. I IFC bør dette ligge i IfcXxxxxx.Tag eller i egenskapen «Reference» i Pset  IfcXxxxxxCommon." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Reference</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>RefString</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10207 : HasThermalRequirements || Kommuniserer at rommet/sonen har krav til termiske egenskaper for (TRUE/ FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_ReqTriggers</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasThermalRequirements</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10802 : ThermalTransmittanceReq || Varmekonduktivitet (U-verdi), oppgis i W/(m²K)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Thermal</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ThermalTransmittanceReq</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NOSSB10002 : HasAcousticReq || Communicates the object has acoustical requirements. Activates checking of object according to NOSSB_Acoustic" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
