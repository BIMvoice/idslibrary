          </ids:name>
        </ids:property>
        <ids:property instructions="5f664480d20611e1800000215ad4efdf : SetPointConcentration || The smoke concentration value to be sensed. Use IfcPropertyBoundedValue.SetPointValue to set the set point value." datatype="[unit error]" minOccurs="1" maxOccurs="unbounded">
