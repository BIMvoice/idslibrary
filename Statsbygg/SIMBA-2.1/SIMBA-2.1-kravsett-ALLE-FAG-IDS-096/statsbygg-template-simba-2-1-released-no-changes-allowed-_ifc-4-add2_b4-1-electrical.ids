          </ids:name>
        </ids:property>
        <ids:property instructions="aecd027ed5424357a5fd13331a99bc51 : IK_Code || IK Code according to IEC 62262 (2002) is a numeric classification for the degree of protection provided by enclosures for electrical equipment against external mechanical impacts.&#10;&lt;blockquote class=&quot;note&quot;&gt;NOTE&amp;nbsp; In earlier labeling, the third numeral (1..) had been occasionally added to the closely related IP Code on ingress protection, to indicate the level of impact protection.&lt;/blockquote&gt;" datatype="[unit error]" minOccurs="1" maxOccurs="unbounded">
