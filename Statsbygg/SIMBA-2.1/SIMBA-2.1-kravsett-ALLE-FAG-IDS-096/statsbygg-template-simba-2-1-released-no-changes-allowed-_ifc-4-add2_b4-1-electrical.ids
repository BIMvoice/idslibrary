          </ids:name>
        </ids:property>
        <ids:property instructions="68571600d20611e1800000215ad4efdf : HasBuiltInAlarm || Indicates whether the smoke sensor is included as an element within a smoke alarm/sensor unit (TRUE) or not (FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
