              <xs:enumeration value="CUP"/>
              <xs:enumeration value="HOTWIRE"/>
              <xs:enumeration value="LASERDOPPLER"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="PLATE"/>
              <xs:enumeration value="SONIC"/>
              <xs:enumeration value="TUBE"/>
              <xs:enumeration value="UNSET"/>
              <xs:enumeration value="WINDMILL"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
