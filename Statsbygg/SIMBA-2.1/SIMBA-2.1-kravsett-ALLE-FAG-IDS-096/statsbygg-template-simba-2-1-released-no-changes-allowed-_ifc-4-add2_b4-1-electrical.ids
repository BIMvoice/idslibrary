        </ids:property>
        <ids:property instructions="56ae4800d1df11e1800000215ad4efdf : IP_Code || IP Code, the International Protection Marking, IEC 60529), classifies and rates the degree of protection provided against intrusion." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
