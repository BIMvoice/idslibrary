          </ids:name>
        </ids:property>
        <ids:property instructions="a2e15fb5e52e49e3b86731401fe07f86 : RatedVoltage || The voltage that a device is designed to handle." datatype="[unit error]" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
