    <ids:specification name="411 Cable Ladder Segment" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCCABLECARRIERSEGMENT</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>CABLELADDERSEGMENT</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
