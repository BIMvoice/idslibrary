        <ids:property instructions="f69a795455c74842825a54711d3b5abc : NominalFrequencyRange || The upper and lower limits of frequency for which the operation of the device is certified." datatype="[unit error]" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
