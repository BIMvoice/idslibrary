        </ids:attribute>
        <ids:property instructions="af83dd80d1eb11e1800000215ad4efdf : LightFixtureMountingType || A list of the available types of mounting for light fixtures from which that required may be selected." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_LightFixtureTypeCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>LightFixtureMountingType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="CABLESPANNED"/>
              <xs:enumeration value="FREESTANDING"/>
              <xs:enumeration value="NOTKNOWN"/>
              <xs:enumeration value="OTHER"/>
              <xs:enumeration value="POLE_SIDE"/>
              <xs:enumeration value="POLE_TOP"/>
              <xs:enumeration value="RECESSED"/>
              <xs:enumeration value="SURFACE"/>
              <xs:enumeration value="SUSPENDED"/>
              <xs:enumeration value="TRACKMOUNTED"/>
              <xs:enumeration value="UNSET"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property instructions="c5919e00d1eb11e1800000215ad4efdf : LightFixturePlacingType || A list of the available types of placing specification for light fixtures from which that required may be selected." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
