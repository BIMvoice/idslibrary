          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HasAcousticReq</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="301 Covering Insulation" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCCOVERING</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>INSULATION</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
