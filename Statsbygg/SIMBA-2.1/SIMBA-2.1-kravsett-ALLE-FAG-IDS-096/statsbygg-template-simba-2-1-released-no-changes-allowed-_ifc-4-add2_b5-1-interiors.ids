        </ids:property>
        <ids:property instructions="de16ae00d21511e1800000215ad4efdf : ThermalTransmittance || Thermal transmittance coefficient (U-Value) of a material.&#10;Here the total thermal transmittance coefficient through the wall (including all materials)." datatype="IFCTHERMALTRANSMITTANCEMEASURE" minOccurs="1" maxOccurs="unbounded">
