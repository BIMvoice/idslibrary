        </ids:property>
        <ids:property instructions="cfc89200d21511e1800000215ad4efdf : Combustible || Indication whether the object is made from combustible material (TRUE) or not (FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
