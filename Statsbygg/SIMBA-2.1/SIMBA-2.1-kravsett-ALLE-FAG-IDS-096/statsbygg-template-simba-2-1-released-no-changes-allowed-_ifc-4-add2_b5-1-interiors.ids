        </ids:property>
        <ids:property instructions="d6570980d21511e1800000215ad4efdf : SurfaceSpreadOfFlame || Indication on how the flames spread around the surface,&#10;It is given according to the national building code that governs the fire behaviour for materials." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
