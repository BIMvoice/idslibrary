        </ids:property>
        <ids:property instructions="f2a87580d21811e1800000215ad4efdf : HasDrive || Indication whether this object has an automatic drive to operate it (TRUE) or no drive (FALSE)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
