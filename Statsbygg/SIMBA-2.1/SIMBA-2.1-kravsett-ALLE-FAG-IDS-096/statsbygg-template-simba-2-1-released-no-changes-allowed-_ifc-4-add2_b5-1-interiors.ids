        </ids:property>
        <ids:property instructions="bffe7d00d21811e1800000215ad4efdf : FireRating || Fire rating for this object.&#10;It is given according to the national fire safety classification." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_WindowCommon</ids:simpleValue>
          </ids:propertySet>
