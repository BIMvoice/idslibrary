        <ids:property instructions="78fa9280d1ec11e1800000215ad4efdf : GlobalTradeItemNumber || The Global Trade Item Number (GTIN) is an identifier for trade items developed by GS1 (www.gs1.org)." datatype="IFCIDENTIFIER" minOccurs="1" maxOccurs="unbounded">
