        <ids:property instructions="NONS10003 : ConstructedStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen i byggefasen." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
