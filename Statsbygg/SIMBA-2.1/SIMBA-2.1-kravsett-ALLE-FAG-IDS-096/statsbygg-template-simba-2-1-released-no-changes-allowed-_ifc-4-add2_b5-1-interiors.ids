          </ids:name>
        </ids:attribute>
        <ids:property instructions="8b66d300d1d011e1800000215ad4efdf : AcousticRating || Acoustic rating for this object.&#10;It is provided according to the national building code. It indicates the sound transmission resistance of this object by an index ratio (instead of providing full sound absorbtion values)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
