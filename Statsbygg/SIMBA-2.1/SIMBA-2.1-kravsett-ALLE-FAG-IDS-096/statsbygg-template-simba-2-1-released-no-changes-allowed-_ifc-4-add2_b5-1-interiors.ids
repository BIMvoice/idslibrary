        <ids:property instructions="cd1b6c00d21811e1800000215ad4efdf : IsExternal || Indication whether the element is designed for use in the exterior (TRUE) or not (FALSE). If (TRUE) it is an external element and faces the outside of the building." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
