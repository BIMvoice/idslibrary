        </ids:property>
        <ids:property instructions="04841b80d20d11e1800000215ad4efdf : RequiredHeadroom || Required headroom clearance for the passageway according to the applicable building code or additional requirements." datatype="IFCPOSITIVELENGTHMEASURE" minOccurs="1" maxOccurs="unbounded">
