<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS ids.xsd">
  <!-- INFO: Export generated by BIMQ. Further information available at https://www.bimq.de -->
  <ids:info>
    <ids:title>Statsbygg TEMPLATE: SIMBA 2.1 (RELEASED - NO CHANGES ALLOWED)</ids:title>
    <ids:version>2.1</ids:version>
    <ids:description>[EN] SIMBA 2.1 requires deliverables on IFC4. It applies to all projects after 2022-07-01. 
[NO] SIMBA 2.1 krever modelleveranser på IFC4. Gjelder for alle nye prosjekter etter 2022-07-01.</ids:description>
    <ids:author>frode.mohus@statsbygg.no</ids:author>
    <ids:date>2023-09-20</ids:date>
    <ids:purpose>Handover (B5.1 Ferdigstillelse) .1</ids:purpose>
    <ids:milestone>Handover (B5.1 Ferdigstillelse)</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification name="001 Project" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001- : ProjectNumber || Statsbygg official Project Number (seven digits)">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-001 : ProjectName || Statsbygg official Project Name">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="002 Site" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001- : SiteName || The official name of the property [no: Eiendomsnavn]">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002- : SiteNumber || The site may additionally have a Statsbygg “property number” [no. Statsbyggs Eiendomsnummer] if so required in the project. If required this naming shall be captured in IfcSite.Longname.">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0003- : LandTitleNumber || The site shall contain the official ID of the Cadastre [no:Matrikkel]  - the Cadastral Number.">
          <ids:name>
            <ids:simpleValue>LandTitleNumber</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="003 Building" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDING</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001- : BuildingName || A descriptive name of the building volume represented by the building object, e.g. &quot;Block D&quot;.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002- : BuildingNumber || Statsbyggs &quot;Byggnummer&quot;">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="f5797b00d1c411e1800000215ad4efdf : BuildingID || Building Number - In Norway the Building number is assigned by the municipality in which the building is located. Each municipality has assigned a numbering range that can be used for the registration of new buildings.  Example: 10469228" datatype="IFCIDENTIFIER" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>BuildingID</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="004 Building Storey" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDINGSTOREY</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001- : BuildingStoreyNumber || The storey names shall be an integer number starting from “1” at the lowest floor level and incrementing by one for each floor level – i.e. storey numbers must not be negative even for storeys below ground.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002- : BuildingStoreyName || Storey name according to Statsbygg document “PA0603” type naming scheme (if so required in the project).">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="82bccf80d1c511e1800000215ad4efdf : EntranceLevel || Indication whether this building storey is an entrance level to the building (TRUE), or (FALSE) if otherwise." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingStoreyCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>EntranceLevel</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="89e3dd80d1c511e1800000215ad4efdf : AboveGround || Indication whether this building storey is fully above ground (TRUE), or below ground (FALSE), or partially above and below ground (UNKNOWN) - as in sloped terrain." datatype="IFCLOGICAL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingStoreyCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>AboveGround</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="005 Spatial Zone" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPATIALZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || GFA = Gross Floor Area [no: BTA = &quot;bruttoareal&quot; according to NS 3940]  UA = Usable Area (total area within a storey, excluding external wall footprint area) [no: &quot;bruksareal&quot; according to NS 3940]  There may be additional types of spatial zones as defined in projects.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10008 : DuplicateOwnedBy || Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>DuplicateOwnedBy</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="005 Zone" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCZONE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-004 : ZoneName || Name for a zone. Used to specify type of zone. &#10;E.g. Security zone, fire safety zone, air handling zone, rental zone etc.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-004 : Description || Any further description of the zone.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0003-002 : LongName || Long name for a zone, used for informal purposes. It should be used, if available, in conjunction with the inherited Name attribute.">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="006 Space" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSPACE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-005 : SpaceFunctionNumber || Spatial Function Number (no: &quot;Romfunksjonsnummer&quot;) according to the project specific spatial program, typically denoted by a main function number, a sub function number, and a sequential room number, dot delimited, e.g. 03.05.004.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-005 : Description || Any further, more specified description of the spatial function (no: &quot;Rombetegnelse&quot;) as named in the LongName field, e.g. &quot;for 20 persons&quot;.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0003-001 : SpatialFunctionCode || 3-digit spatial code and name (no: &quot;Romnavn&quot;) according to Norwegian Standard NS3457-4:2015 Classification of construction works - Part 4: Spatial functions. Syntax according to the standard, i.e. first the 3-digit code followed by a space and then the name, e.g. &quot;212 Møterom&quot; (en: 212 Meeting room). &#10;&#10;Special case: Gross Floor Area (GFA) objects shall specifically be denoted &quot;BTA&quot; (no: &quot;bruttoareal&quot;) in this field, optionally followed by a space and a further specification, e.g. &quot;BTA Floor 3&quot;.">
          <ids:name>
            <ids:simpleValue>LongName</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="76f2fc80d20911e1800000215ad4efdf : FireExit || Indication whether this object is designed to serve as an exit in the case of fire (TRUE) or not (FALSE).&#10;Here whether the space (in case of e.g., a corridor) is designed to serve as an exit space, e.g., for fire escape purposes." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceFireSafetyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>FireExit</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="00ee9580d20911e1800000215ad4efdf : GrossPlannedArea || Total planned gross area for the space. Used for programming the space." datatype="IFCAREAMEASURE" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GrossPlannedArea</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="06e47680d20911e1800000215ad4efdf : NetPlannedArea || Total PLANNED net area for the spatial function (no: &quot;Programmert areal&quot;). Used for programming the space. If set to zero the planned spatial function may have requirements but NOT quantified for planned net area (this will typically be relevant for spatial functions like corridors, staircases and technical spaces where the area depends on the suggested design solution)." datatype="IFCAREAMEASURE" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>NetPlannedArea</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="0d72ee00d20911e1800000215ad4efdf : PubliclyAccessible || Indication whether this space (in case of e.g., a toilet) is designed to serve as a publicly accessible space, e.g., for a public toilet (TRUE) or not (FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>PubliclyAccessible</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="1499fc00d20911e1800000215ad4efdf : HandicapAccessible || Indication whether this space (in case of e.g., a toilet) is designed to serve as an accessible space for handicapped people, e.g., for a public toilet (TRUE) or not (FALSE). This information is often used to declare the need for access for the disabled and for special design requirements of this space." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>HandicapAccessible</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="f7fdc400d20811e1800000215ad4efdf : IsExternal || Indication whether the element is designed for use in the exterior (TRUE) or not (FALSE). If (TRUE) it is an external element and faces the outside of the building." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IsExternal</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="e61d2080d20a11e1800000215ad4efdf : MinimumHeadroom || Functional height of the spatial function, i.e. measured from top of floor covering to bottom of the lowest suspended ceiling, suspended light fixture or other relevant installation that limits the free height in the spatial function for the intended activity.&#10;&#10;Definition from IFC: Headroom required for the activity assigned to this space." datatype="IFCLENGTHMEASURE" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>MinimumHeadroom</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="eae1d480d20a11e1800000215ad4efdf : IsOutlookDesirable || A requirement for daylight exposure for the spatial function, normally by direct daylighting through glazed elements, but could also be indirectly through the use of mirror constructions, fibre optics etc.&#10;&#10;Definition from IFC: An indication of whether the outlook is desirable (set TRUE) or not (set FALSE)" datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IsOutlookDesirable</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="007 Grid" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCGRID</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-001 : Name || A descriptive name of the grid.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="008 Annotation" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCANNOTATION</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-007 : Name || Optional name for use by the participating software systems or users. For some subtypes of IfcRoot the insertion of the Name attribute may be required. This would be enforced by a where rule.">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="009 Geographic Element" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCGEOGRAPHICELEMENT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001&#10;&#10;Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="NONS10003 : ConstructedStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen i byggefasen." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ConstructedStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10008 : DuplicateOwnedBy || Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>DuplicateOwnedBy</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10010 : IsProcured || Kommuniserer at produktet som objektet representerer er innkjøpt. Selv om objektet ikke er ferdig prosjektert skal geometri og egenskaper være representative for det innkjøpte produktet. Denne kan brukes som alternativ til kode under ConstructedStatus som angir om produktet som objektet representerer er innkjøpt." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>IsProcured</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10013 : ProcessStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen, uavhengig av fase. Denne egenskapen brukes som alternativ til DesignedStatus, ConstructedStatus og OperationalStatus." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ProcessStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="100 Flow Segment" ifcVersion="IFC4" minOccurs="0" maxOccurs="unbounded">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:pattern value="IFCCABLECARRIERSEGMENT|IFCCABLESEGMENT|IFCDUCTSEGMENT|IFCPIPESEGMENT|IFCFLOWSEGMENT"/>
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute instructions="0001-003 : Name || Mandatory: Building component code (no: NS3457-8:2021 Komponentkode) + type code (three digit serial number). Example syntax AVA.001  Optionally: In case a subcode is required to differ between variations within an object type or specific object type functions an sub type code (two digit number) can be added. Example syntax AVA.001.01">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute instructions="0002-006 : Description || User defined description of element type, its material and when applicable composite. Description shall communicate all properties relevant for cost and construction that are not communicated by other object properties.&#10;&#10;Applies to disciplines Architect (ARK), Structural Engineer (RIB) and Landscape Architect (LARK):&#10;&#10;If the software does not allow usage of Description, Statsbygg accepts usage of IfcMaterial for describing the object type. Usage of Description or Material shall be consistent for all objects and all models from the same discipline.&#10;&#10;Applies to disciplines Mechanical and Plumbing Engineer and Electrical Engineer:&#10;&#10;To the extent the Name sufficiently communicates all properties relevant for cost and construction that are not communicated by other object properties, the Description requirement can be omitted. This shall be confirmed by the appointing party.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:property instructions="78fa9280d1ec11e1800000215ad4efdf : GlobalTradeItemNumber || The Global Trade Item Number (GTIN) is an identifier for trade items developed by GS1 (www.gs1.org)." datatype="IFCIDENTIFIER" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_ManufacturerTypeInformation</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>GlobalTradeItemNumber</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10003 : ConstructedStatus || Kommuniserer objektets modenhetsgrad i beslutnings- og kvalitetssikringsprosessen i byggefasen." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>NONS_Process</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>ConstructedStatus</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="NONS10008 : DuplicateOwnedBy || Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
