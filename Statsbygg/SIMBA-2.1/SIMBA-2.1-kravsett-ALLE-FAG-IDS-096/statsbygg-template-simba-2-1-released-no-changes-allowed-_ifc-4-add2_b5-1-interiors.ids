        </ids:property>
        <ids:property instructions="22518080d20d11e1800000215ad4efdf : FireExit || Indication whether this object is designed to serve as an exit in the case of fire (TRUE) or not (FALSE).&#10;Here it defines an exit stair in accordance to the national building code." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_StairCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>FireExit</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="29788e80d20d11e1800000215ad4efdf : HasNonSkidSurface || Indication whether the surface finish is designed to prevent slippery (TRUE) or not (FALSE)." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
