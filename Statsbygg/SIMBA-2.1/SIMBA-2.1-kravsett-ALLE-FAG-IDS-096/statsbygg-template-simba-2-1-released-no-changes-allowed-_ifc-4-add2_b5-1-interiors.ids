          </ids:name>
        </ids:property>
        <ids:property instructions="aa3b8880d21511e1800000215ad4efdf : Reference || Reference ID for this specified type in this project (e.g. type 'A-1'), Also referred to as &quot;construction type&quot;. It should be provided as an alternative to the name of the &quot;object type&quot;, if the software does not support object types." datatype="IFCIDENTIFIER" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_WallCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
