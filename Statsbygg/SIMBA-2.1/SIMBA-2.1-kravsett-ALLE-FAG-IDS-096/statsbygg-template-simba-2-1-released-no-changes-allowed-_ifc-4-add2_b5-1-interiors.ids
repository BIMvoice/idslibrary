          </ids:name>
        </ids:property>
        <ids:property instructions="005dfb00d21911e1800000215ad4efdf : FireExit || Indication whether this object is designed to serve as an exit in the case of fire (TRUE) or not (FALSE). Here it defines an exit window in accordance to the national building code." datatype="IFCBOOLEAN" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_WindowCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
            <ids:simpleValue>FireExit</ids:simpleValue>
          </ids:name>
        </ids:property>
        <ids:property instructions="b9700580d21811e1800000215ad4efdf : AcousticRating || Acoustic rating for this object.&#10;It is provided according to the national building code. It indicates the sound transmission resistance of this object by an index ratio (instead of providing full sound absorbtion values)." datatype="IFCLABEL" minOccurs="1" maxOccurs="unbounded">
          <ids:propertySet>
            <ids:simpleValue>Pset_WindowCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:name>
